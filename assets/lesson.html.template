    roots.forEach(b => {
      if (!cat) {
        b.classList.remove('plogic-filtering');
        b.querySelectorAll('.dm').forEach(dm => dm.classList.remove('filter-on'));
      } else {
        b.classList.add('plogic-filtering');
        b.querySelectorAll('.dm').forEach(dm => dm.classList.toggle('filter-on', dm.dataset.cat === cat));
      }
    });
  };
  const setMarkCat = (cat) => {
    activeMarkCat = cat;
    legendBar.querySelectorAll('.plogic-legend-chip').forEach(ch => {
      const on = !!cat && ch.dataset.cat === cat;
      ch.classList.toggle('active', on);
      ch.classList.toggle('marking', on);
    });
    applyFilter(cat);
    hideDmFloatBtn();
  };
  legendBar.querySelectorAll('.plogic-legend-chip').forEach(chip => {
    chip.addEventListener('click', (e) => {
      e.stopPropagation();
      const cat = chip.dataset.cat;
      setMarkCat(activeMarkCat === cat ? null : cat);
    });
  });
  legendBar.querySelectorAll('.plogic-legend-reset').forEach(resetBtn => {
    resetBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      setMarkCat(null);
    });
  });
  bindLegendAddForm(legendBar);
}
function closeParagraphLogic() {
