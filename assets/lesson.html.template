/* ---------- Structure diagram (layout-aware SVG) ---------- */
function structureTone(tone) {
  const fills = { mint:'#DCF0EE', gold:'#FBEBCB', coral:'#FBE4D6', plum:'#EDE6F5' };
  const texts = { mint:'#0D5A62', gold:'#7A5610', coral:'#9A3F1B', plum:'#6B4E8E' };
  return { fill: fills[tone] || fills.mint, text: texts[tone] || texts.mint };
}
function structureNodeBox(x, y, w, h, n) {
  const t = structureTone(n.tone);
  return `<rect x="${x}" y="${y}" width="${w}" height="${h}" rx="10" fill="${t.fill}"/>
    <text x="${x + w/2}" y="${y + 18}" text-anchor="middle" fill="${t.text}" font-size="10" font-weight="700" font-family="Work Sans,sans-serif">${esc(n.label)}</text>
    <text x="${x + w/2}" y="${y + 32}" text-anchor="middle" fill="${t.text}" font-size="9" font-family="Work Sans,sans-serif">${esc(n.sub || '')}</text>`;
}
function structureArrow(x1, y1, x2, y2) {
  return `<line x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}" stroke="#8A9AA0" stroke-width="2" marker-end="url(#arrowHead)"/>`;
}
function renderStructureSvg(s) {
  const nodes = s.nodes || [];
  const layout = s.layout || 'hub';
  const marker = '<defs><marker id="arrowHead" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto"><polygon points="0 0, 8 3, 0 6" fill="#8A9AA0"/></marker></defs>';
  if (layout === 'timeline' || layout === 'sequence') {
    const count = Math.max(nodes.length, 1);
    const gap = 16;
    const boxW = Math.min(92, Math.floor((420 - 40 - gap * (count - 1)) / count));
    const total = count * boxW + (count - 1) * gap;
    const startX = (420 - total) / 2;
    let svg = marker;
    nodes.forEach((n, i) => {
      const x = startX + i * (boxW + gap);
      svg += structureNodeBox(x, 95, boxW, 50, n);
      if (i < count - 1) svg += structureArrow(x + boxW + 2, 120, x + boxW + gap - 2, 120);
    });
    return `<svg viewBox="0 0 420 240" width="100%" height="220" xmlns="http://www.w3.org/2000/svg">${svg}</svg>`;
  }
  if (layout === 'compare') {
    const left = nodes[0] || { label:'Side A', sub:'' };
    const right = nodes[1] || { label:'Side B', sub:'' };
    const shared = nodes[2] || { label: (s.centerLines || ['Both'])[0], sub: s.centerSub || '' };
    return `<svg viewBox="0 0 420 240" width="100%" height="220" xmlns="http://www.w3.org/2000/svg">${marker}
      ${structureNodeBox(30, 70, 130, 56, left)}
      ${structureNodeBox(260, 70, 130, 56, right)}
      <ellipse cx="210" cy="185" rx="72" ry="28" fill="#6B4E8E"/>
      <text x="210" y="182" text-anchor="middle" fill="white" font-size="10" font-weight="700" font-family="Work Sans,sans-serif">${esc(shared.label)}</text>
      <text x="210" y="196" text-anchor="middle" fill="#E0D6F0" font-size="9" font-family="Work Sans,sans-serif">${esc(shared.sub || '')}</text>
      <line x1="160" y1="126" x2="190" y2="160" stroke="#C9BFE0" stroke-width="2"/>
      <line x1="260" y1="126" x2="230" y2="160" stroke="#C9BFE0" stroke-width="2"/>
    </svg>`;
  }
  if (layout === 'problem-solution') {
    const problem = nodes[0] || { label:'Problem', sub:'' };
    const solutions = nodes.slice(1);
    let svg = marker + structureNodeBox(24, 88, 120, 56, problem) + structureArrow(146, 116, 174, 116);
    const solCount = Math.max(solutions.length, 1);
    const boxW = Math.min(110, Math.floor((220 - 16 * (solCount - 1)) / solCount));
    solutions.forEach((n, i) => {
      const x = 176 + i * (boxW + 16);
      svg += structureNodeBox(x, 88, boxW, 56, n);
    });
    if (!solutions.length) svg += structureNodeBox(176, 88, 120, 56, { label:'Solution', sub:'', tone:'gold' });
    return `<svg viewBox="0 0 420 220" width="100%" height="200" xmlns="http://www.w3.org/2000/svg">${svg}</svg>`;
  }
  // hub (description / concept map) — default
  const positions = [{ x:90, y:50 }, { x:330, y:50 }, { x:90, y:210 }, { x:330, y:210 }];
  let lines = '', rects = '';
  nodes.slice(0, 4).forEach((n, i) => {
    const p = positions[i];
    lines += `<line x1="210" y1="130" x2="${p.x}" y2="${p.y}" stroke="#C9BFE0" stroke-width="2"/>`;
    rects += structureNodeBox(p.x - 64, p.y - 22, 128, 44, n);
  });
  const c1 = esc((s.centerLines || [''])[0] || '');
  const c2 = esc((s.centerLines || ['', ''])[1] || '');
  return `<svg viewBox="0 0 420 260" width="100%" height="230" xmlns="http://www.w3.org/2000/svg">
    ${lines}
    <ellipse cx="210" cy="130" rx="76" ry="36" fill="#6B4E8E"/>
    <text x="210" y="123" text-anchor="middle" fill="white" font-size="11" font-weight="700" font-family="Work Sans,sans-serif">${c1}</text>
    <text x="210" y="137" text-anchor="middle" fill="white" font-size="11" font-weight="700" font-family="Work Sans,sans-serif">${c2}</text>
    <text x="210" y="152" text-anchor="middle" fill="#E0D6F0" font-size="9" font-family="Work Sans,sans-serif">${esc(s.centerSub || '')}</text>
    ${rects}
  </svg>`;
}
(function renderStructure() {
  const s = whileR.structure;
  if (!s) return;
  const back = `<div class="mindmap-wrap">${renderStructureSvg(s)}<div class="card-summary content-zh">${s.summaryHtml || ''}</div></div>`;
  document.getElementById('structureCard').appendChild(buildFlipCard({
