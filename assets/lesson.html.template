/* ---------- True / False ---------- */
const tfItems = whileR.trueFalse || [];
const tfState = {};
tfItems.forEach(item => {
  const row = document.createElement('div'); row.className = 'tf-item';
  row.innerHTML = `
    <div class="tf-text"><span class="tf-num">${item.n}</span> ${esc(item.text)}</div>
    <div class="tf-buttons"><button class="tf-btn" data-choice="true">True</button><button class="tf-btn" data-choice="false">False</button></div>
    <div class="tf-feedback"></div>`;
  const buttons = row.querySelectorAll('.tf-btn');
  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      if (row.dataset.submitted) return;
      buttons.forEach(b => b.classList.remove('picked'));
      btn.classList.add('picked');
      tfState[item.n] = btn.dataset.choice === 'true';
    });
  });
  document.getElementById('tfList').appendChild(row);
});
document.getElementById('tfSubmit').addEventListener('click', () => {
  let correctCount = 0;
  const tfList = document.getElementById('tfList');
  tfItems.forEach((item, idx) => {
    const row = tfList.children[idx];
    row.dataset.submitted = '1';
    const buttons = row.querySelectorAll('.tf-btn');
    const feedback = row.querySelector('.tf-feedback');
    const picked = tfState[item.n];
    buttons.forEach(b => b.classList.remove('picked'));
    if (picked === undefined) {
      feedback.textContent = 'No answer selected. ' + (item.answer ? 'True. ' : 'False. ') + item.reason;
    } else {
      const correct = picked === item.answer;
      if (correct) correctCount++;
      buttons.forEach(b => {
        if ((b.dataset.choice === 'true') === picked) b.classList.add(correct ? 'chosen-correct' : 'chosen-wrong');
        if (!correct && (b.dataset.choice === 'true') === item.answer) b.classList.add('reveal-correct');
      });
      feedback.textContent = (item.answer ? 'True. ' : 'False. ') + item.reason;
    }
    feedback.classList.add('show');
  });
  document.getElementById('tfScore').textContent = `${correctCount} / ${tfItems.length} correct`;
  document.getElementById('tfScore').classList.add('show');
  document.getElementById('tfSubmit').style.display = 'none';
  document.getElementById('tfRetry').classList.add('show');
});
document.getElementById('tfRetry').addEventListener('click', () => {
  Object.keys(tfState).forEach(k => delete tfState[k]);
  Array.from(document.getElementById('tfList').children).forEach(row => {
    delete row.dataset.submitted;
    row.querySelectorAll('.tf-btn').forEach(b => b.classList.remove('picked','chosen-correct','chosen-wrong','reveal-correct'));
    const fb = row.querySelector('.tf-feedback'); fb.classList.remove('show'); fb.textContent = '';
  });
  document.getElementById('tfScore').classList.remove('show');
  document.getElementById('tfSubmit').style.display = 'inline-block';
  document.getElementById('tfRetry').classList.remove('show');
});

/* ---------- Vocab match ---------- */
const vocab = whileR.vocabMatch || [];
document.getElementById('vocabMatchHint').textContent = whileR.vocabMatchHint || '';
document.getElementById('doneBanner').textContent = whileR.vocabDoneMessage || '🎉 All matched!';
const wordCol = document.getElementById('wordCol');
const meaningCol = document.getElementById('meaningCol');
let selectedWord = null, solvedCount = 0;
function buildMatch() {
  wordCol.innerHTML = ''; meaningCol.innerHTML = ''; solvedCount = 0; selectedWord = null;
  document.getElementById('doneBanner').classList.remove('show'); updateProgress();
  shuffle(vocab).forEach(v => {
    const b = document.createElement('button'); b.className = 'chip word'; b.textContent = v.word; b.dataset.word = v.word;
    b.addEventListener('click', () => onWordClick(b, v)); wordCol.appendChild(b);
  });
  shuffle(vocab).forEach(v => {
    const b = document.createElement('button'); b.className = 'chip meaning'; b.textContent = v.meaning; b.dataset.word = v.word;
    b.addEventListener('click', () => onMeaningClick(b, v)); meaningCol.appendChild(b);
  });
}
function onWordClick(btn, v) {
  if (btn.classList.contains('solved')) return;
  wordCol.querySelectorAll('.chip').forEach(c => c.classList.remove('selected'));
  btn.classList.add('selected'); selectedWord = { btn, v };
}
function onMeaningClick(btn, v) {
  if (btn.classList.contains('solved') || !selectedWord) return;
  if (selectedWord.v.word === v.word) {
    btn.classList.add('solved'); btn.classList.remove('selected');
    selectedWord.btn.classList.add('solved'); selectedWord.btn.classList.remove('selected');
    selectedWord = null; solvedCount++; updateProgress();
    if (solvedCount === vocab.length) document.getElementById('doneBanner').classList.add('show');
  } else {
    btn.classList.add('shake'); selectedWord.btn.classList.add('shake');
    setTimeout(() => {
      btn.classList.remove('shake');
      selectedWord && selectedWord.btn.classList.remove('shake','selected');
      selectedWord = null;
      wordCol.querySelectorAll('.chip').forEach(c => c.classList.remove('selected'));
    }, 350);
  }
}
function updateProgress() {
  const n = Math.max(vocab.length, 1);
  document.getElementById('matchBar').style.width = (solvedCount / n * 100) + '%';
  document.getElementById('matchCount').textContent = `${solvedCount} / ${vocab.length} matched`;
}
document.getElementById('matchReset').addEventListener('click', buildMatch);
buildMatch();

/* ---------- Persist user edits into INITIAL_DATA ---------- */
function hydrateFromLocalStorageIfNewer() {
  try {
    const stem = INITIAL_DATA.meta?.filenameStem;
    if (!stem) return;
    const raw = localStorage.getItem(`lesson:${stem}`);
    if (!raw) return;
    const saved = JSON.parse(raw);
    if ((saved._savedAt || 0) > (INITIAL_DATA._savedAt || 0)) {
      Object.keys(INITIAL_DATA).forEach(k => delete INITIAL_DATA[k]);
      Object.assign(INITIAL_DATA, JSON.parse(JSON.stringify(saved)));
    }
  } catch (_) {}
}

function extractPassagePHtml(p) {
  const clone = p.cloneNode(true);
