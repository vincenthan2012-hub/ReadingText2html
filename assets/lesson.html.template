function openParagraphLogic(cardEl, c) {
  closeParagraphLogic();
  const logic = c.paragraphLogic || { steps: [], devices: [] };
  const idx = twCardEls.indexOf(cardEl);
  const slide = idx >= 0 ? carouselSlides[idx] : null;
  const panel = slide ? slide.querySelector('.plogic-panel') : null;
  const btn = cardEl.querySelector('.plogic-btn');
  cardEl.classList.add('plogic-open');
  if (btn) {
    btn.classList.add('active');
    btn.setAttribute('aria-pressed', 'true');
  }
  if (panel) panel.classList.add('open');
  activePlogicCard = cardEl;

  lastHighlighted.forEach(e => e.classList.remove('persist-hl'));
  lastHighlighted = [];
  const scope = getPlogicScopeForCard(cardEl);

  const { root, bodies } = getPlogicHighlightRoots(cardEl, c);
  if (root) root.classList.add('plogic-hl');
  bodies.forEach(body => body.classList.add('plogic-hl'));
  const legendBar = ensureSectionLegendBar(c.targets, scope, logic.devices);
  const filterRoots = root && root.classList.contains('carousel-passage') ? [root] : bodies;
  if (legendBar) bindSectionLegendFilter(legendBar, filterRoots);

  // Default-select first logic step (no scroll — avoids clipping Signpost via overflow scroll)
  const first = logic.steps && logic.steps[0];
  if (first) selectPlogicStep(cardEl, c, first.id, false);

  syncCarouselHeight();
  resetCarouselScroll();
  requestAnimationFrame(() => {
    syncCarouselHeight();
    resetCarouselScroll();
  });
}
function passageParaTargetId(el) {
  const host = el && el.closest('.passage-para');
  if (!host) return '';
  const marked = host.querySelector('[data-para-target]');
  if (marked) return marked.getAttribute('data-para-target') || '';
  const p = host.querySelector('p[id]');
  return (p && p.id) || '';
}
function selectPlogicStep(cardEl, c, stepId, allowScroll = true) {
  const idx = twCardEls.indexOf(cardEl);
  const slide = idx >= 0 ? carouselSlides[idx] : null;
  const panel = slide ? slide.querySelector('.plogic-panel') : null;
  if (panel) {
    panel.querySelectorAll('.plogic-flow-step').forEach(b => {
      b.classList.toggle('active', String(b.dataset.step) === String(stepId));
    });
  }
  // Scope to this card's target paragraphs. Step ids must be unique within the section —
  // never reset data-step="1" on every paragraph's first sentence in a multi-para section.
  const { root, bodies } = getPlogicHighlightRoots(cardEl, c);
  const searchRoots = root && root.classList.contains('carousel-passage') ? [root] : bodies;
  const targetSet = new Set((c.targets || []).map(String));
  const matches = [];
  searchRoots.forEach(body => {
    body.querySelectorAll('.sent-step').forEach(s => {
      const paraId = passageParaTargetId(s);
      const inTargets = !targetSet.size || !paraId || targetSet.has(paraId);
      const on = inTargets && String(s.dataset.step) === String(stepId);
      s.classList.toggle('step-active', on);
      if (on) matches.push(s);
    });
  });
  if (matches.length > 1) {
    console.warn(
      `[Paragraph Logic] step "${stepId}" matched ${matches.length} spans. ` +
      `Each data-step id must be unique across the section (do not reuse the same id on every paragraph).`
    );
  }
  if (!allowScroll) return;
  const hit = matches[0];
  if (!hit) return;
  const wrap = document.querySelector('.carousel-track-wrap');
  const beforeTop = wrap ? wrap.scrollTop : 0;
  hit.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  requestAnimationFrame(() => {
    resetCarouselScroll();
    if (wrap && wrap.scrollTop !== beforeTop) wrap.scrollTop = 0;
    syncCarouselHeight();
  });
}
function buildPlogicPanel(c) {
  const logic = c.paragraphLogic || { steps: [], devices: [] };
  const multiPara = (c.targets || []).length > 1;
  const flowLabel = multiPara ? 'Section Logic · 整段发展逻辑' : 'Paragraph Logic · 段落发展逻辑';
  const flowParts = [];
  (logic.steps || []).forEach((s, idx) => {
    const zh = s.labelZh ? `<span class="content-zh inline">${esc(s.labelZh)}</span>` : '';
    flowParts.push(`<button type="button" class="plogic-flow-step" data-step="${esc(s.id)}"><span class="num">${idx + 1}</span>${esc(s.labelEn)}${zh}</button>`);
    if (idx < logic.steps.length - 1) flowParts.push(`<span class="plogic-flow-arrow" aria-hidden="true">→</span>`);
  });
  const panel = document.createElement('div');
  panel.className = 'plogic-panel carousel-plogic-panel';
  panel.innerHTML = `
    <div class="plogic-flow-label">${flowLabel}</div>
    <div class="plogic-flow-strip">${flowParts.join('') || '<span style="font-size:12px;color:var(--ink-soft);">暂无逻辑步骤</span>'}</div>`;
  return panel;
}
