}
function getPlogicScopeForCard(cardEl) {
  const panel = document.getElementById('panel-while');
  if (panel.classList.contains('while-mode-details')) return getActiveCarouselSlide();
  return cardEl.closest('.carousel-slide') || null;
}
function getPlogicPassageRoot(cardEl, c) {
  const scope = getPlogicScopeForCard(cardEl);
  if (scope) {
    const root = scope.querySelector('.carousel-passage');
    if (root) return root;
  }
  const bodies = getPassageBodiesForTargets((c && c.targets) || [], scope);
  return bodies[0] || null;
}
function getPassageBodiesForTargets(targets, scope) {
  return (targets || []).map(id => {
    const el = findTargetElement(id, scope);
    if (!el) return null;
    return el.closest('.passage-body') || el.closest('.carousel-passage') || el;
  }).filter(Boolean);
}
function getPlogicHighlightRoots(cardEl, c) {
  const root = getPlogicPassageRoot(cardEl, c);
  if (root && root.classList.contains('carousel-passage')) {
    const bodies = [...root.querySelectorAll('.passage-body')];
    return { root, bodies: bodies.length ? bodies : [root] };
  }
  const scope = getPlogicScopeForCard(cardEl);
  const bodies = getPassageBodiesForTargets((c && c.targets) || [], scope);
  return { root: root || bodies[0] || null, bodies };
}
let activeMarkCat = null;
let dmFloatBtn = null;
let dmFloatMode = null; // 'add' | 'remove'
let dmFloatTarget = null;

function ensureDmFloatBtn() {
  if (dmFloatBtn) return dmFloatBtn;
  dmFloatBtn = document.createElement('button');
  dmFloatBtn.type = 'button';
  dmFloatBtn.className = 'dm-float-btn';
  dmFloatBtn.setAttribute('aria-label', 'Toggle signpost mark');
  document.body.appendChild(dmFloatBtn);
  dmFloatBtn.addEventListener('mousedown', (e) => e.preventDefault());
  dmFloatBtn.addEventListener('click', (e) => {
    e.preventDefault();
    e.stopPropagation();
    if (dmFloatMode === 'add' && activeMarkCat) {
      wrapSelectionWithDm(activeMarkCat);
    } else if (dmFloatMode === 'remove' && dmFloatTarget) {
      unwrapDm(dmFloatTarget);
    }
    hideDmFloatBtn();
    window.getSelection()?.removeAllRanges();
  });
  return dmFloatBtn;
}
function hideDmFloatBtn() {
  if (!dmFloatBtn) return;
  dmFloatBtn.classList.remove('show');
  dmFloatMode = null;
  dmFloatTarget = null;
}
function unwrapDm(dmEl) {
  if (!dmEl || !dmEl.parentNode) return;
  const parent = dmEl.parentNode;
  while (dmEl.firstChild) parent.insertBefore(dmEl.firstChild, dmEl);
  parent.removeChild(dmEl);
  parent.normalize();
  schedulePersist();
}
function wrapSelectionWithDm(cat) {
  const sel = window.getSelection();
  if (!sel || sel.isCollapsed || !sel.rangeCount) return;
  const range = sel.getRangeAt(0);
  if (!range.toString().trim()) return;
  const span = document.createElement('span');
  span.className = 'dm';
  span.dataset.cat = cat;
  try {
    range.surroundContents(span);
  } catch (_) {
    const frag = range.extractContents();
    span.appendChild(frag);
    range.insertNode(span);
  }
  // Keep filter state in sync if filtering is on
  if (span.closest('.plogic-filtering')) {
    span.classList.toggle('filter-on', span.dataset.cat === activeMarkCat);
  }
  schedulePersist();
}
function findDmCoveringRange(range) {
  const startEl = range.startContainer.nodeType === 1 ? range.startContainer : range.startContainer.parentElement;
  const endEl = range.endContainer.nodeType === 1 ? range.endContainer : range.endContainer.parentElement;
  if (!startEl || !endEl) return null;
  const startDm = startEl.closest && startEl.closest('.dm[data-cat]');
  const endDm = endEl.closest && endEl.closest('.dm[data-cat]');
  if (startDm && startDm === endDm) return startDm;
  return null;
}
function selectionInPlogicPassage(range) {
  const node = range.commonAncestorContainer;
  const el = node.nodeType === 1 ? node : node.parentElement;
  if (!el) return false;
  const root = el.closest('.carousel-passage.plogic-hl, .passage-body.plogic-hl');
  return !!root;
}
function updateDmFloatFromSelection() {
  if (!activePlogicCard) { hideDmFloatBtn(); return; }
  const sel = window.getSelection();
  if (!sel || sel.isCollapsed || !sel.rangeCount) { hideDmFloatBtn(); return; }
  const range = sel.getRangeAt(0);
  if (!range.toString().trim() || !selectionInPlogicPassage(range)) { hideDmFloatBtn(); return; }

  const btn = ensureDmFloatBtn();
  const covered = findDmCoveringRange(range);
  const rect = range.getBoundingClientRect();
  if (!rect || (!rect.width && !rect.height)) { hideDmFloatBtn(); return; }

  if (covered) {
    dmFloatMode = 'remove';
    dmFloatTarget = covered;
    const st = PLOGIC_CAT_STYLE[covered.dataset.cat] || PLOGIC_CAT_STYLE.addition;
    btn.textContent = '−';
    btn.style.background = st.deep;
    btn.title = 'Remove signpost highlight';
  } else if (activeMarkCat) {
    dmFloatMode = 'add';
    dmFloatTarget = null;
    const st = PLOGIC_CAT_STYLE[activeMarkCat] || PLOGIC_CAT_STYLE.addition;
    btn.textContent = '+';
    btn.style.background = st.deep;
    btn.title = 'Add signpost highlight';
  } else {
    hideDmFloatBtn();
    return;
  }
  btn.style.left = (rect.left + rect.width / 2) + 'px';
  btn.style.top = rect.top + 'px';
  btn.classList.add('show');
}
function clearPlogicPassageUI() {
  activeMarkCat = null;
  hideDmFloatBtn();
  document.querySelectorAll('.passage-body.plogic-hl, .carousel-passage.plogic-hl').forEach(body => {
    body.classList.remove('plogic-hl', 'plogic-filtering');
    body.querySelectorAll('.sent-step').forEach(s => s.classList.remove('step-active'));
    body.querySelectorAll('.dm').forEach(dm => dm.classList.remove('filter-on'));
  });
  document.querySelectorAll('.plogic-legend-bar').forEach(bar => {
    bar.hidden = true;
    bar.innerHTML = '';
    bar.remove();
  });
}
function renderLegendBar(bar) {
  const custom = customLegendStore.get(bar._legendKey) || [];
  custom.forEach(d => {
    if (d.light && d.deep) registerDmCatStyle(d.cat, d.light, d.deep);
  });
  const all = [...(bar._baseDevices || []), ...custom];
  bar.innerHTML = buildLegendHTML(all);
}
function ensureSectionLegendBar(targets, scope, devices) {
  const firstEl = findTargetElement(targets[0], scope);
  const firstPara = firstEl && firstEl.closest('.passage-para');
  if (!firstPara) return null;
  const passage = firstPara.closest('.carousel-passage') || firstPara.parentElement;
  let bar = passage && passage.querySelector(':scope > .plogic-legend-bar');
  if (!bar) {
    bar = firstPara.previousElementSibling;
    if (!bar || !bar.classList.contains('plogic-legend-bar')) {
      bar = document.createElement('div');
      bar.className = 'plogic-legend-bar plogic-legend';
    }
  }
  // Always keep legend as the first child of the passage so it sits under card padding
  if (passage && passage.firstElementChild !== bar) {
    passage.insertBefore(bar, passage.firstElementChild);
  } else if (!bar.parentElement && firstPara) {
    firstPara.insertAdjacentElement('beforebegin', bar);
  }
  const key = legendStoreKey(targets);
  if (!customLegendStore.has(key)) customLegendStore.set(key, []);
