<script>
const INITIAL_DATA = __INITIAL_DATA_JSON__;
hydrateFromLocalStorageIfNewer();

const meta = INITIAL_DATA.meta;
const tips = INITIAL_DATA.teacherTips || {};
const pre = INITIAL_DATA.preReading;
const whileR = INITIAL_DATA.whileReading;
const post = INITIAL_DATA.postReading;

function esc(s) {
  return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

/* ---------- Hero ---------- */
(function renderHero() {
  const badges = (meta.badges || []).map(b => `<span class="badge">${esc(b)}</span>`).join('');
  const objs = (meta.objectives || []).map(o => `<li>${esc(o)}</li>`).join('');
  document.getElementById('heroInner').innerHTML = `
    <div class="hero-top">
      <div class="badges">${badges}</div>
      <div class="hero-actions">
        <div class="tts-voice-wrap" id="ttsVoiceWrap" title="选择语音朗读音色 · Choose TTS Voice">
          <span class="tts-icon">🔊</span>
          <select id="ttsVoiceSelect" class="tts-voice-select">
            <option value="">Default Voice (默认语音)</option>
          </select>
        </div>
        <button type="button" class="hero-btn" id="editBtn" aria-pressed="false">Edit</button>
        <div class="export-wrap">
          <button type="button" class="hero-btn" id="exportBtn" aria-haspopup="true" aria-expanded="false">Export ▾</button>
          <div class="export-menu" id="exportMenu">
            <button type="button" class="export-item" data-export="save">Save changes to HTML</button>
            <button type="button" class="export-item" data-export="html">Export all as HTML</button>
            <button type="button" class="export-item" data-export="pdf">Export current as PDF</button>
          </div>
        </div>
      </div>
    </div>
    <h1 class="title display">${esc(meta.titleEn)}</h1>
    <div class="objectives">
      <div class="objectives-label">Lesson objectives</div>
      <ul>${objs}</ul>
      <div class="time-est">${esc(meta.timeEstimate || '')}</div>
    </div>`;
  document.getElementById('pageFooter').textContent = meta.footer || 'Reading & Writing courseware · Pre / While / Post lesson flow';
})();

/* ---------- TTS Engine ---------- */
let availableVoices = [];
let selectedVoiceURI = '';
let currentSpeakingBtn = null;

function setTtsBtnState(btn, state) {
  if (!btn) return;
  const isPara = btn.classList.contains('para-tts-btn');
  const meta = {
    idle: isPara
      ? { title: '朗读该段 · Listen to paragraph', aria: 'Listen to paragraph', icon: '🔊' }
      : { title: '发音 · Pronounce', aria: 'Pronounce', icon: '🔊' },
    speaking: { title: '暂停朗读 · Pause', aria: 'Pause reading', icon: '⏸' },
    paused: { title: '继续朗读 · Resume', aria: 'Resume reading', icon: '▶' },
  };
  const m = meta[state] || meta.idle;
  btn.title = m.title;
  btn.setAttribute('aria-label', m.aria);
  btn.textContent = m.icon;
  btn.classList.toggle('speaking', state === 'speaking');
  btn.classList.toggle('paused', state === 'paused');
}

function stopSpeaking() {
  if ('speechSynthesis' in window) {
    window.speechSynthesis.cancel();
  }
  if (currentSpeakingBtn) {
    setTtsBtnState(currentSpeakingBtn, 'idle');
    currentSpeakingBtn = null;
  }
}

function speakText(text, triggerBtn) {
  if (!('speechSynthesis' in window)) {
    alert('Browser Speech Synthesis (TTS) is not supported in this browser.');
    return;
  }
  if (currentSpeakingBtn === triggerBtn) {
    if (window.speechSynthesis.paused) {
      window.speechSynthesis.resume();
      setTtsBtnState(triggerBtn, 'speaking');
      return;
    }
    if (window.speechSynthesis.speaking) {
      window.speechSynthesis.pause();
      setTtsBtnState(triggerBtn, 'paused');
      return;
    }
  }
  stopSpeaking();

  const cleanText = text.replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim();
  if (!cleanText) return;

  const utter = new SpeechSynthesisUtterance(cleanText);
  utter.rate = 0.95;
  utter.pitch = 1.0;
  utter.lang = 'en-US';

  if (selectedVoiceURI && availableVoices.length) {
    const v = availableVoices.find(item => item.voiceURI === selectedVoiceURI);
    if (v) utter.voice = v;
  }

  if (triggerBtn) {
    currentSpeakingBtn = triggerBtn;
    setTtsBtnState(triggerBtn, 'speaking');
  }

  utter.onend = () => {
    if (triggerBtn) setTtsBtnState(triggerBtn, 'idle');
    if (currentSpeakingBtn === triggerBtn) currentSpeakingBtn = null;
  };
  utter.onerror = () => {
    if (triggerBtn) setTtsBtnState(triggerBtn, 'idle');
    if (currentSpeakingBtn === triggerBtn) currentSpeakingBtn = null;
  };

  window.speechSynthesis.speak(utter);
}

function initTTS() {
  if (!('speechSynthesis' in window)) {
    const wrap = document.getElementById('ttsVoiceWrap');
    if (wrap) wrap.style.display = 'none';
    return;
  }

  function populateVoiceList() {
    const voices = window.speechSynthesis.getVoices() || [];
    if (!voices.length) return;
    availableVoices = voices;
    const sel = document.getElementById('ttsVoiceSelect');
    if (!sel) return;

    // Prioritize English voices
    const enVoices = voices.filter(v => v.lang && v.lang.toLowerCase().startsWith('en'));
    const displayList = enVoices.length ? enVoices : voices;

    sel.innerHTML = '<option value="">Default English Voice</option>' +
      displayList.map(v => `<option value="${esc(v.voiceURI)}">${esc(v.name)} (${esc(v.lang)})</option>`).join('');

    if (selectedVoiceURI) {
      sel.value = selectedVoiceURI;
    } else if (enVoices.length) {
      const preferred = enVoices.find(v => /natural|samantha|daniel|karen|alex|google/i.test(v.name)) || enVoices[0];
      if (preferred) {
        selectedVoiceURI = preferred.voiceURI;
        sel.value = selectedVoiceURI;
      }
    }
  }

  populateVoiceList();
  if (window.speechSynthesis.onvoiceschanged !== undefined) {
    window.speechSynthesis.onvoiceschanged = populateVoiceList;
  }
  const sel = document.getElementById('ttsVoiceSelect');
  if (sel) {
    sel.addEventListener('change', (e) => {
      selectedVoiceURI = e.target.value;
      if (window.speechSynthesis.speaking) stopSpeaking();
    });
  }
}
initTTS();

/* ---------- Pre-reading ---------- */
(function renderPre() {
  const tipBtn = pre.leadIn.tipKey ? `<button class="tip-btn" data-tip="${esc(pre.leadIn.tipKey)}">i</button>` : '';
  document.getElementById('preLeadIn').innerHTML = `
    <div class="section-head"><span class="section-num">1</span><h2 class="section-title display">Lead-in · 导入</h2>${tipBtn}</div>
    <div class="prompt-box">
      <p class="q">${esc(pre.leadIn.prompt)}</p>
      <textarea placeholder="${esc(pre.leadIn.placeholder || '')}"></textarea>
    </div>`;
  document.getElementById('prePrediction').innerHTML = `
    <div class="section-head"><span class="section-num">2</span><h2 class="section-title display">Predict · 预测</h2></div>
    <p class="section-hint">${esc(pre.prediction.hint || '')}</p>
    <div class="prompt-box">
      <p class="q">${esc(pre.prediction.prompt)}</p>
      <textarea placeholder="${esc(pre.prediction.placeholder || '')}"></textarea>
    </div>`;
})();

/* ---------- Post-reading ---------- */
(function renderPost() {
  const panel = document.getElementById('panel-post');
  const speakCards = (post.speaking.prompts || []).map((p, i) => `
    <div class="speak-card"><div class="qnum display">${i + 1}</div><p>${esc(p.prompt)}</p>
    <textarea placeholder="${esc(p.placeholder || '')}"></textarea></div>`).join('');
  const sides = (post.textToWorld.sides || []).map(s =>
    `<button class="side-btn" data-side="${esc(s.id)}">${esc(s.label)}</button>`).join('');
  const debateTip = post.textToWorld.tipKey ? `<button class="tip-btn" data-tip="${esc(post.textToWorld.tipKey)}">i</button>` : '';
  const exitTip = post.exitTicket.tipKey ? `<button class="tip-btn" data-tip="${esc(post.exitTicket.tipKey)}">i</button>` : '';
  panel.innerHTML = `
    <section>
      <div class="section-head"><span class="section-num">1</span><h2 class="section-title display">Check your prediction · 验证预测</h2></div>
      <div class="prompt-box">
        <p class="q">${esc(post.predictionCheck.prompt)}</p>
        <textarea placeholder="${esc(post.predictionCheck.placeholder || '')}"></textarea>
      </div>
    </section>
    <section>
      <div class="section-head"><span class="section-num">2</span><h2 class="section-title display">Speaking · Work in pairs</h2></div>
      <p class="section-hint">${esc(post.speaking.hint || '')}</p>
      <div class="speak-grid">${speakCards}</div>
    </section>
    <section>
      <div class="section-head"><span class="section-num">3</span><h2 class="section-title display">Text-to-Self · 联系自身</h2></div>
      <div class="prompt-box">
        <span class="strategy-tag self">Text-to-Self</span>
        <p class="q">${esc(post.textToSelf.prompt)}</p>
        <textarea placeholder="${esc(post.textToSelf.placeholder || '')}"></textarea>
      </div>
    </section>
    <section>
      <div class="section-head"><span class="section-num">4</span><h2 class="section-title display">Text-to-World · 联系现实世界</h2>${debateTip}</div>
      <div class="prompt-box">
        <span class="strategy-tag world">Text-to-World</span>
        <p class="q">${esc(post.textToWorld.prompt)}</p>
        <div class="side-toggle">${sides}</div>
        <textarea placeholder="${esc(post.textToWorld.placeholder || '')}"></textarea>
        <div class="subprompt-label">延伸 · Also consider</div>
        <p class="q" style="font-size:13.5px;">${esc(post.textToWorld.extensionPrompt || '')}</p>
        <textarea placeholder="${esc(post.textToWorld.extensionPlaceholder || '')}"></textarea>
      </div>
    </section>
    <section>
      <div class="section-head"><span class="section-num">5</span><h2 class="section-title display">Exit ticket · 一句话总结</h2>${exitTip}</div>
      <div class="prompt-box">
        <p class="q">${esc(post.exitTicket.prompt)}</p>
        <textarea placeholder="${esc(post.exitTicket.placeholder || '')}"></textarea>
      </div>
    </section>`;
})();

/* ---------- Navigation & tips ---------- */
const modalBackdrop = document.getElementById('modalBackdrop');
const modalText = document.getElementById('modalText');
document.querySelectorAll('.tip-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    modalText.textContent = tips[btn.dataset.tip] || '';
    modalBackdrop.classList.add('show');
  });
});
document.getElementById('modalClose').addEventListener('click', () => modalBackdrop.classList.remove('show'));
modalBackdrop.addEventListener('click', (e) => { if (e.target === modalBackdrop) modalBackdrop.classList.remove('show'); });

document.querySelectorAll('.stage-tab').forEach(tab => tab.addEventListener('click', () => goToStage(tab.dataset.stage)));
document.querySelectorAll('.next-btn').forEach(btn => btn.addEventListener('click', () => goToStage(btn.dataset.goto)));
function goToStage(stage) {
  document.querySelectorAll('.stage-tab').forEach(t => t.classList.toggle('active', t.dataset.stage === stage));
  document.querySelectorAll('.stage-panel').forEach(p => p.classList.toggle('active', p.id === 'panel-' + stage));
  window.scrollTo({ top:0, behavior:'smooth' });
}
function setActivityView(view) {
  document.querySelectorAll('.activity-tab').forEach(t => t.classList.toggle('active', t.dataset.view === view));
  document.querySelectorAll('.activity-view').forEach(v => v.classList.toggle('active', v.id === 'view-' + view));
  const panel = document.getElementById('panel-while');
  panel.classList.toggle('while-mode-gist', view === 'gist');
  panel.classList.toggle('while-mode-details', view === 'details');
  if (view === 'details') {
    closeParagraphLogic();
    ensureDetailsReady();
  }
}
function setSubview(sub) {
  document.querySelectorAll('.subtab').forEach(t => t.classList.toggle('active', t.dataset.sub === sub));
  document.querySelectorAll('.subview').forEach(v => v.classList.toggle('active', v.id === 'sub-' + sub));
}
document.querySelectorAll('.activity-tab').forEach(tab => tab.addEventListener('click', () => setActivityView(tab.dataset.view)));
document.querySelectorAll('.subtab').forEach(t => t.addEventListener('click', () => setSubview(t.dataset.sub)));
document.querySelectorAll('.light-tabs').forEach(group => {
  group.querySelectorAll('.light-tab').forEach(t => {
    t.addEventListener('click', () => {
      group.querySelectorAll('.light-tab').forEach(x => x.classList.toggle('active', x === t));
      group.parentElement.querySelectorAll('.light-view').forEach(v => v.classList.toggle('active', v.id === 'lv-' + t.dataset.lv));
    });
  });
});
document.querySelectorAll('.side-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    btn.parentElement.querySelectorAll('.side-btn').forEach(b => b.classList.remove('chosen'));
    btn.classList.add('chosen');
  });
});

/* ---------- Passage + highlight + Paragraph TTS ---------- */
function formatPassageParagraph(p, i) {
  const withOpen = p.replace(/<p\b([^>]*)>/i, `<div class="passage-para"><span class="passage-num" aria-hidden="true">${i + 1}</span><div class="passage-body"><p$1>`);
  return withOpen.replace(/<\/p>/i, `<button type="button" class="para-tts-btn" title="朗读该段 · Listen to paragraph" aria-label="Listen to paragraph" data-para-idx="${i}">🔊</button></p></div></div>`);
}
function excerptHTMLFromData(targets) {
  const paragraphs = whileR.passageParagraphs || [];
  return (targets || []).map(id => {
    const m = String(id).match(/^para-(\d+)$/);
    if (!m) return '';
    const idx = parseInt(m[1], 10) - 1;
    const p = paragraphs[idx];
    if (!p) return '';
    return formatPassageParagraph(p, idx).replace(/\sid=(["'])([^"']+)\1/g, ' data-para-target="$2"');
  }).join('');
}

const passagePane = document.getElementById('passagePane');
passagePane.innerHTML = (whileR.passageParagraphs || []).map((p, i) => formatPassageParagraph(p, i)).join('');

passagePane.querySelectorAll('.para-tts-btn').forEach(btn => {
  btn.addEventListener('click', (e) => {
    e.stopPropagation();
    const p = btn.closest('p');
    if (!p) return;
    const clone = p.cloneNode(true);
    clone.querySelectorAll('.para-tts-btn').forEach(b => b.remove());
    speakText(clone.innerText, btn);
  });
});

document.querySelectorAll('.vocab').forEach(span => {
  span.addEventListener('click', () => {
    setActivityView('details'); setSubview('check');
    setTimeout(() => {
      const chip = document.querySelector(`.chip.word[data-word="${span.dataset.word}"]`);
      setHighlight(chip);
    }, 200);
  });
});
let lastHighlighted = [];
function getActiveCarouselSlide() {
  return document.querySelector('.carousel-slide.active');
}
function findTargetElement(id, scope) {
  if (scope) {
    const hit = scope.querySelector(`[data-para-target="${id}"]`) || scope.querySelector(`[id="${CSS.escape(id)}"]`);
    if (hit) return hit;
  }
  return document.getElementById(id);
}
function getSectionIndexForTarget(el) {
  const id = el && (el.id || el.getAttribute('data-para-target'));
  if (!id) return -1;
  return (whileR.textWalkthrough || []).findIndex(c => (c.targets || []).includes(id));
}
function setHighlight(elsOrEl) {
  const els = (Array.isArray(elsOrEl) ? elsOrEl : [elsOrEl]).filter(Boolean);
  const panel = document.getElementById('panel-while');
  const inDetails = panel.classList.contains('while-mode-details');
  let resolved = els;
  if (inDetails && els[0]) {
    const id = els[0].id || els[0].getAttribute('data-para-target');
    if (id) {
      const idx = getSectionIndexForTarget({ id });
      if (idx >= 0 && typeof goToCarouselSlide === 'function') goToCarouselSlide(idx);
      const slide = getActiveCarouselSlide();
      const visible = slide && findTargetElement(id, slide);
      if (visible) resolved = [visible];
    }
  }
  lastHighlighted.forEach(e => e.classList.remove('persist-hl'));
  lastHighlighted = resolved;
  lastHighlighted.forEach(e => e.classList.add('persist-hl'));
  if (lastHighlighted[0] && !inDetails) {
    lastHighlighted[0].scrollIntoView({ behavior:'smooth', block:'center' });
  } else if (lastHighlighted[0] && inDetails) {
    lastHighlighted[0].scrollIntoView({ behavior:'smooth', block:'nearest' });
  }
}
function highlightTargets(ids) {
  const scope = document.getElementById('panel-while').classList.contains('while-mode-details')
