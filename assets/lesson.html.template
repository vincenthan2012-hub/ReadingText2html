  (items || []).forEach(it => grid.appendChild(buildVocabFlipCard(it, kind)));
  container.appendChild(grid);
  return grid;
}

function renumberLangItems(card) {
  card.querySelectorAll('.lang-item .n').forEach((n, i) => { n.textContent = String(i + 1); });
}

function buildLangCard(container, title, subtitle, tag, items) {
  const el = document.createElement('div'); el.className = 'fcard langcard';
  el.innerHTML = `
    <div class="fcard-header">
      <div class="htext"><div class="en display">${title}</div><div class="zh">${subtitle || ''}</div></div>
      <div style="display:flex;align-items:center;gap:6px;">${tag ? `<span class="tag">${tag}</span>` : ''}<button type="button" class="lang-card-del" title="删除结构卡片" aria-label="Delete">×</button></div>
    </div>
    <div class="lang-items">${(items || []).map((it,i) => `
      <div class="lang-item" data-target="${esc(it.target || '')}">
        <span class="n">${i+1}</span>
        <span class="lang-item-content">${it.html || esc(it.text || '')}</span>
        <button type="button" class="lang-item-del" title="删除例句" aria-label="Delete item">×</button>
      </div>`).join('')}
    </div>
    <div style="padding:0 14px 14px;"><button type="button" class="lang-item-add">＋ 添加例句</button></div>`;
  el.querySelector('.lang-card-del').addEventListener('click', (e) => {
    e.stopPropagation();
    el.remove();
    schedulePersist();
  });
  el.querySelectorAll('.lang-item').forEach((row) => {
    row.querySelector('.lang-item-del').addEventListener('click', (e) => {
      e.stopPropagation();
      row.remove();
      renumberLangItems(el);
      schedulePersist();
    });
    row.addEventListener('click', (e) => {
      if (e.target.closest('.lang-item-del')) return;
      if (row.dataset.target) setHighlight(document.getElementById(row.dataset.target));
    });
  });
  el.querySelector('.lang-item-add').addEventListener('click', () => {
    const text = window.prompt('输入例句或结构示例：');
    if (!text || !text.trim()) return;
    const itemsWrap = el.querySelector('.lang-items');
    const row = document.createElement('div');
    row.className = 'lang-item';
    row.dataset.target = '';
    row.innerHTML = `<span class="n"></span><span class="lang-item-content">${esc(text.trim())}</span><button type="button" class="lang-item-del" title="删除例句" aria-label="Delete item">×</button>`;
    row.querySelector('.lang-item-del').addEventListener('click', (e) => {
      e.stopPropagation();
      row.remove();
      renumberLangItems(el);
      schedulePersist();
    });
    itemsWrap.appendChild(row);
    renumberLangItems(el);
    schedulePersist();
  });
  container.appendChild(el);
  return el;
}

