function collectPassageParagraphs() {
  const carouselParas = new Map();
  document.querySelectorAll('.carousel-passage .passage-para').forEach(para => {
    const p = para.querySelector('.passage-body p');
    const id = p?.id || para.querySelector('[data-para-target]')?.getAttribute('data-para-target');
    if (id && p) carouselParas.set(id, extractPassagePHtml(p));
  });
  const pane = document.getElementById('passagePane');
  if (!pane) return whileR.passageParagraphs || [];
  return [...pane.querySelectorAll('.passage-para')].map(para => {
    const p = para.querySelector('.passage-body p');
    if (!p) return '';
    if (p.id && carouselParas.has(p.id)) return carouselParas.get(p.id);
    return extractPassagePHtml(p);
  });
}

