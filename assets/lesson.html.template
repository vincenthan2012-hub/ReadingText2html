function collectLessonState() {
  const data = JSON.parse(JSON.stringify(INITIAL_DATA));
  collectEditableFields(data);
  data.whileReading.passageParagraphs = collectPassageParagraphs();
  data.whileReading.powerWords = collectVocabItems('power');
  data.whileReading.phrases = collectVocabItems('phrase');
  data.whileReading.structures = collectStructures();
  data.whileReading.customSignpostLegends = collectCustomSignpostLegends();
  data.whileReading.textWalkthrough = collectTextWalkthrough();
  data._savedAt = Date.now();
  return data;
}

function replaceInitialDataInScript(scriptText, newData) {
  const marker = 'const INITIAL_DATA = ';
  const start = scriptText.indexOf(marker);
  if (start < 0) return scriptText;
  const jsonStart = start + marker.length;
  let depth = 0;
  let inString = false;
  let escape = false;
  let quote = '';
  for (let i = jsonStart; i < scriptText.length; i++) {
    const ch = scriptText[i];
    if (inString) {
      if (escape) escape = false;
      else if (ch === '\\') escape = true;
      else if (ch === quote) inString = false;
      continue;
    }
    if (ch === '"' || ch === "'") { inString = true; quote = ch; continue; }
    if (ch === '{') depth++;
    if (ch === '}') {
      depth--;
      if (depth === 0) return scriptText.slice(0, jsonStart) + JSON.stringify(newData) + scriptText.slice(i + 1);
    }
  }
  return scriptText;
}

function applyLessonStateToMemory(state) {
  Object.keys(INITIAL_DATA).forEach(k => delete INITIAL_DATA[k]);
  Object.assign(INITIAL_DATA, JSON.parse(JSON.stringify(state)));
  whileR.passageParagraphs = INITIAL_DATA.whileReading.passageParagraphs;
  whileR.powerWords = INITIAL_DATA.whileReading.powerWords;
  whileR.phrases = INITIAL_DATA.whileReading.phrases;
  whileR.structures = INITIAL_DATA.whileReading.structures;
  whileR.customSignpostLegends = INITIAL_DATA.whileReading.customSignpostLegends;
  whileR.textWalkthrough = INITIAL_DATA.whileReading.textWalkthrough;
  twSections = whileR.textWalkthrough || [];
}

let persistTimer = null;
function schedulePersist() {
  clearTimeout(persistTimer);
  persistTimer = setTimeout(() => persistLessonState(), 500);
}

function persistLessonState() {
  const state = collectLessonState();
  applyLessonStateToMemory(state);
  document.querySelectorAll('script').forEach(script => {
    if (script.textContent.includes('const INITIAL_DATA = ')) {
      script.textContent = replaceInitialDataInScript(script.textContent, state);
    }
  });
  try {
    localStorage.setItem(`lesson:${meta.filenameStem}`, JSON.stringify(state));
  } catch (_) {}
  return state;
}

