function shuffle(arr) { return [...arr].sort(() => Math.random() - 0.5); }
const gistParas = gist.paragraphFunctions || [];
const gistParaCol = document.getElementById('gistParaCol');
const gistFuncCol = document.getElementById('gistFuncCol');
let gistSelected = null, gistSolved = 0;
function buildGist() {
  gistParaCol.innerHTML = ''; gistFuncCol.innerHTML = ''; gistSolved = 0; gistSelected = null;
  document.getElementById('gistDone').classList.remove('show'); updateGistProgress();
  shuffle(gistParas).forEach(g => {
    const b = document.createElement('button'); b.className = 'chip word'; b.textContent = g.p; b.dataset.p = g.p;
    b.addEventListener('click', () => onGistParaClick(b, g)); gistParaCol.appendChild(b);
  });
  shuffle(gistParas).forEach(g => {
    const b = document.createElement('button'); b.className = 'chip'; b.textContent = g.label; b.dataset.p = g.p;
    b.addEventListener('click', () => onGistFuncClick(b, g)); gistFuncCol.appendChild(b);
  });
}
function onGistParaClick(btn, g) {
  if (btn.classList.contains('solved')) return;
  gistParaCol.querySelectorAll('.chip').forEach(c => c.classList.remove('selected'));
  btn.classList.add('selected'); gistSelected = { btn, g };
}
function onGistFuncClick(btn, g) {
  if (btn.classList.contains('solved') || !gistSelected) return;
  if (gistSelected.g.p === g.p) {
    btn.classList.add('solved'); btn.classList.remove('selected');
    gistSelected.btn.classList.add('solved'); gistSelected.btn.classList.remove('selected');
    gistSelected = null; gistSolved++; updateGistProgress();
    if (gistSolved === gistParas.length) document.getElementById('gistDone').classList.add('show');
  } else {
    btn.classList.add('shake'); gistSelected.btn.classList.add('shake');
    setTimeout(() => {
      btn.classList.remove('shake');
      gistSelected && gistSelected.btn.classList.remove('shake','selected');
      gistSelected = null;
      gistParaCol.querySelectorAll('.chip').forEach(c => c.classList.remove('selected'));
    }, 350);
  }
}
function updateGistProgress() {
  const n = Math.max(gistParas.length, 1);
  document.getElementById('gistBar').style.width = (gistSolved / n * 100) + '%';
  document.getElementById('gistCount').textContent = `${gistSolved} / ${gistParas.length} matched`;
}
buildGist();
document.getElementById('gistReset').addEventListener('click', buildGist);

