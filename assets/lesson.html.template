let twSections = whileR.textWalkthrough || [];
let carouselIndex = 0;
const twCardEls = [];
const carouselSlides = [];
let detailsReady = false;

function syncCarouselHeight() {
  const wrap = document.querySelector('.carousel-track-wrap');
  const viewport = document.querySelector('.carousel-viewport');
  const activeInner = document.querySelector('.carousel-slide.active .carousel-slide-inner');
  if (!wrap || !activeInner) return;
  // Measure with height:auto so newly injected Signpost legend is included
  wrap.style.height = 'auto';
  const h = Math.ceil(activeInner.getBoundingClientRect().height);
  wrap.style.height = h + 'px';
  // overflow:hidden + scrollIntoView can shift scrollTop and clip the legend — always reset
  wrap.scrollTop = 0;
  if (viewport) viewport.scrollTop = 0;
  activeInner.scrollTop = 0;
  const passage = activeInner.querySelector('.carousel-passage');
  if (passage) passage.scrollTop = 0;
}
function resetCarouselScroll() {
  document.querySelectorAll('.carousel-viewport, .carousel-track-wrap, .carousel-slide-inner, .carousel-passage').forEach(el => {
    el.scrollTop = 0;
  });
}

function goToCarouselSlide(idx) {
  if (idx < 0 || idx >= twSections.length) return;
  closeParagraphLogic();
  carouselIndex = idx;
  updateCarouselUI();
}

function updateTwVisibility() {
  twCardEls.forEach((card, i) => {
    const show = i === carouselIndex;
    card.hidden = !show;
    if (!show && activePlogicCard === card) closeParagraphLogic();
  });
}

function updateCarouselUI() {
  const n = twSections.length;
  const track = document.getElementById('carouselTrack');
  if (!track) return;
  track.style.transform = `translateX(-${carouselIndex * 100}%)`;
  track.querySelectorAll('.carousel-slide').forEach((s, i) => {
    s.classList.toggle('active', i === carouselIndex);
  });
  document.querySelectorAll('.carousel-dot').forEach((d, i) => {
    d.classList.toggle('active', i === carouselIndex);
  });
  const prev = document.getElementById('carouselPrev');
  const next = document.getElementById('carouselNext');
  if (prev) prev.disabled = carouselIndex === 0;
  if (next) next.disabled = carouselIndex >= n - 1;
  updateTwVisibility();
  requestAnimationFrame(syncCarouselHeight);
}

function bindCarouselInteractions(root) {
  root.querySelectorAll('.para-tts-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const p = btn.closest('p');
      if (!p) return;
      const clone = p.cloneNode(true);
      clone.querySelectorAll('.para-tts-btn').forEach(b => b.remove());
      speakText(clone.innerText, btn);
    });
  });
  root.querySelectorAll('.vocab').forEach(span => {
    span.addEventListener('click', () => {
      setActivityView('details');
      setSubview('check');
      setTimeout(() => {
        const chip = document.querySelector(`.chip.word[data-word="${span.dataset.word}"]`);
        setHighlight(chip);
      }, 200);
    });
  });
}

function buildSectionCarousel() {
  const track = document.getElementById('carouselTrack');
  const dots = document.getElementById('carouselDots');
  if (!track || !dots || !twSections.length) return;
  track.innerHTML = '';
  dots.innerHTML = '';
  carouselSlides.length = 0;

  twSections.forEach((c, i) => {
    const slide = document.createElement('div');
    slide.className = 'carousel-slide' + (i === 0 ? ' active' : '');
    slide.dataset.sectionIdx = String(i);

    const inner = document.createElement('div');
    inner.className = 'carousel-slide-inner';

    const passageDiv = document.createElement('div');
    passageDiv.className = 'carousel-passage';
    passageDiv.innerHTML = excerptHTMLFromData(c.targets);

    const plogicPanel = buildPlogicPanel(c);
    plogicPanel.querySelectorAll('.plogic-flow-step').forEach(stepBtn => {
      stepBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const twCard = twCardEls[i];
        if (!twCard) return;
        if (activePlogicCard !== twCard) openParagraphLogic(twCard, c);
        selectPlogicStep(twCard, c, stepBtn.dataset.step);
      });
    });

    inner.appendChild(passageDiv);
    inner.appendChild(plogicPanel);
    slide.appendChild(inner);
    track.appendChild(slide);
    carouselSlides.push(slide);

    const dot = document.createElement('button');
    dot.type = 'button';
    dot.className = 'carousel-dot' + (i === 0 ? ' active' : '');
    dot.setAttribute('role', 'tab');
    dot.setAttribute('aria-label', `Section ${i + 1}: ${c.title}`);
    dot.addEventListener('click', () => goToCarouselSlide(i));
    dots.appendChild(dot);
  });

  bindCarouselInteractions(track);
  carouselIndex = 0;
  updateCarouselUI();
}

function buildTwCards() {
  const twList = document.getElementById('twList');
  if (!twList || twCardEls.length) return;
  twSections.forEach((c, i) => {
    const card = buildWalkthroughCard(c, i);
    card.hidden = i !== 0;
    twCardEls.push(card);
    twList.appendChild(card);
  });
}

function ensureDetailsReady() {
  if (detailsReady) {
    requestAnimationFrame(syncCarouselHeight);
    return;
  }
  detailsReady = true;
  buildTwCards();
  buildSectionCarousel();
}

document.getElementById('carouselPrev').addEventListener('click', () => goToCarouselSlide(carouselIndex - 1));
document.getElementById('carouselNext').addEventListener('click', () => goToCarouselSlide(carouselIndex + 1));
window.addEventListener('resize', () => { if (detailsReady) syncCarouselHeight(); });
