/* ---------- Language cards with TTS ---------- */
function extractItemSpeakText(it) {
  if (it.word) return String(it.word).replace(/\s*\/\s*/g, ' ').trim();
  if (it.target) {
    const targetEl = document.getElementById(it.target);
    if (targetEl) return targetEl.innerText;
  }
  const raw = it.html || it.text || '';
  const matchStrong = raw.match(/<strong>(.*?)<\/strong>/i);
  if (matchStrong) return matchStrong[1].replace(/<[^>]*>/g, '').trim();
  return raw.replace(/<[^>]*>/g, '').split(/[:：—]/)[0].trim();
}

function flipVocabCard(card) {
  const faces = card.querySelectorAll('.vocab-flip-face');
  const active = card.querySelector('.vocab-flip-face.active');
  if (!active) return;
  active.classList.add('flipping');
  setTimeout(() => {
    faces.forEach(f => f.classList.toggle('active'));
    active.classList.remove('flipping');
  }, 220);
}

