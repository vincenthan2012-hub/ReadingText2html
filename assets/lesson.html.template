    const labelEn = enInput.value.trim();
    if (!labelEn) { enInput.focus(); return; }
    const labelZh = zhInput.value.trim();
    const deep = colorInput.value;
    const light = deriveLightColor(deep);
    const cat = `custom-${++customLegendCounter}`;
    registerDmCatStyle(cat, light, deep);
    const custom = customLegendStore.get(legendBar._legendKey) || [];
    custom.push({ cat, labelEn, labelZh, light, deep });
    customLegendStore.set(legendBar._legendKey, custom);
    enInput.value = '';
    zhInput.value = '';
    form.hidden = true;
    renderLegendBar(legendBar);
    bindSectionLegendFilter(legendBar, legendBar._filterRoots || []);
    const chip = legendBar.querySelector(`[data-cat="${cat}"]`);
    if (chip) chip.click();
    schedulePersist();
  });
}
function bindSectionLegendFilter(legendBar, roots) {
