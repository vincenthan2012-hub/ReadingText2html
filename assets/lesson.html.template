  }));
})();

/* ---------- Text walkthrough (typed per-question flip rows + Paragraph Logic) ---------- */
const QTYPE_META = {
  Fact: { letter: 'F', cls: 'fact' },
  Infer: { letter: 'I', cls: 'infer' },
  Tone: { letter: 'T', cls: 'tone' },
  Vocabulary: { letter: 'V', cls: 'vocabulary' },
  Structure: { letter: 'S', cls: 'structure' },
  Reflect: { letter: 'R', cls: 'reflect' },
};
const PLOGIC_CAT_STYLE = {
  cause: { light: '#F9CBA6', deep: '#C97A3D' },
  contrast: { light: '#F7C6D9', deep: '#C4577E' },
  addition: { light: '#B7E4C7', deep: '#3F8259' },
  sequence: { light: '#DCF0EE', deep: '#0D5A62' },
  hedge: { light: '#CBC3E3', deep: '#6B5A9E' },
};
const PLOGIC_ICON = `<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="6" r="2.2"/><circle cx="18" cy="6" r="2.2"/><circle cx="12" cy="18" r="2.2"/><path d="M8 7.2 10.8 15M16 7.2 13.2 15"/></svg>`;
let activePlogicCard = null;
const customLegendStore = new Map();
let customLegendCounter = 0;

function legendStoreKey(targets) {
  return (targets || []).join('|');
}
function deriveLightColor(deep) {
  return `color-mix(in srgb, ${deep} 35%, white)`;
}
function registerDmCatStyle(cat, light, deep) {
  PLOGIC_CAT_STYLE[cat] = { light, deep };
  const id = `dm-style-${cat}`;
  let el = document.getElementById(id);
  if (!el) {
    el = document.createElement('style');
    el.id = id;
    document.head.appendChild(el);
  }
  el.textContent = `
    .passage-body.plogic-hl .dm[data-cat="${cat}"],
    .carousel-passage.plogic-hl .dm[data-cat="${cat}"]{ background:${light}; color:${deep}; }`;
}
function hydrateCustomLegendsFromData() {
  const legends = whileR.customSignpostLegends || {};
  Object.entries(legends).forEach(([key, devices]) => {
    if (!devices || !devices.length) return;
    customLegendStore.set(key, devices);
    devices.forEach(d => {
      if (d.cat && d.light && d.deep) {
        registerDmCatStyle(d.cat, d.light, d.deep);
        const m = String(d.cat).match(/^custom-(\d+)$/);
        if (m) customLegendCounter = Math.max(customLegendCounter, parseInt(m[1], 10));
      }
    });
  });
}
hydrateCustomLegendsFromData();

function qtypeMeta(type) {
  return QTYPE_META[type] || { letter: (type || '?')[0].toUpperCase(), cls: 'fact' };
}
function qtypeBadgeHTML(type) {
  const m = qtypeMeta(type);
  return `<span class="qtype-badge ${m.cls}"><span class="qtype-letter">${m.letter}</span>${esc(type)}</span>`;
}
function renderQuestionAnswerHTML(q) {
  let html = '';
  if (q.bulletsEn && q.bulletsEn.length) {
    html += `<ul>${q.bulletsEn.map(b => `<li><strong>${esc(b[0])}</strong>: ${esc(b[1])}</li>`).join('')}</ul>`;
  }
  if (q.answerEn) html += `<div>${esc(q.answerEn)}</div>`;
  const zhParts = [];
  if (q.bulletsZh && q.bulletsZh.length) {
    zhParts.push(`<ul>${q.bulletsZh.map(b => `<li><strong>${esc(b[0])}</strong>：${esc(b[1])}</li>`).join('')}</ul>`);
  }
  if (q.answerZh) zhParts.push(`<div>${esc(q.answerZh)}</div>`);
  if (zhParts.length) html += `<div class="zh content-zh">${zhParts.join('')}</div>`;
  return html || '<div class="card-summary">（暂无解析）</div>';
}
function flipQuestionItem(item) {
  const faces = item.querySelectorAll('.tw-qface');
  const active = item.querySelector('.tw-qface.active');
  if (!active) return;
  active.classList.add('flipping');
  setTimeout(() => {
    faces.forEach(f => f.classList.toggle('active'));
    active.classList.remove('flipping');
