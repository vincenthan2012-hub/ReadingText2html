<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>__TITLE_EN__ — Reading Lesson</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Work+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
<noscript><link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Work+Sans:wght@400;500;600;700&display=swap" rel="stylesheet"></noscript>
<style>
  :root{
    --sand:#FBF5E9; --sand-deep:#F2E7D3;
    --ocean-deep:#0D5A62; --ocean-mid:#16818A; --ocean-light:#DCF0EE;
    --coral:#E2703A; --coral-light:#FBE4D6;
    --gold:#E0A233; --gold-light:#FBEBCB;
    --plum:#6B4E8E; --plum-light:#EDE6F5;
    --ink:#1C2B2E; --ink-soft:#4B5D60;
    --white:#FFFFFF; --line:#E4DAC5; --radius:14px;
  }
  *{box-sizing:border-box;}
  body{ margin:0; background:var(--sand); color:var(--ink); font-family:system-ui,-apple-system,'Segoe UI',sans-serif; line-height:1.6; -webkit-font-smoothing:antialiased; }
  body.fonts-ready{ font-family:'Work Sans',system-ui,-apple-system,sans-serif; }
  .display{ font-family:Georgia,'Times New Roman',serif; }
  body.fonts-ready .display{ font-family:'Fraunces',Georgia,serif; }
  .stripe{ height:8px; width:100%; background:repeating-linear-gradient(90deg, var(--coral) 0 24px, var(--gold) 24px 48px, var(--ocean-mid) 48px 72px, var(--ink) 72px 74px); }

  header.hero{ background:linear-gradient(180deg, var(--ocean-deep) 0%, #0A464C 100%); color:var(--sand); padding:32px 24px 28px; }
  .hero-inner{ max-width:1180px; margin:0 auto; }
  .hero-top{ display:flex; justify-content:space-between; align-items:flex-start; gap:16px; margin-bottom:14px; }
  .badges{ display:flex; gap:10px; flex-wrap:wrap; }
  .hero-actions{ display:flex; gap:8px; align-items:center; flex-shrink:0; flex-wrap:wrap; }
  .hero-btn{ font-family:'Work Sans',sans-serif; font-size:12px; font-weight:600; letter-spacing:.04em; padding:7px 14px; border-radius:999px; border:1px solid rgba(251,245,233,.4); background:rgba(251,245,233,.12); color:var(--sand); cursor:pointer; transition:background .15s ease, border-color .15s ease; }
  .hero-btn:hover{ background:rgba(251,245,233,.22); border-color:rgba(251,245,233,.6); }
  .hero-btn[aria-pressed="true"]{ background:var(--gold); border-color:var(--gold); color:var(--ink); }
  
  /* TTS Voice selector in Hero */
  .tts-voice-wrap{ display:inline-flex; align-items:center; gap:6px; background:rgba(251,245,233,.12); border:1px solid rgba(251,245,233,.4); border-radius:999px; padding:3px 10px 3px 8px; color:var(--sand); }
  .tts-icon{ font-size:13px; line-height:1; }
  .tts-voice-select{ background:transparent; border:none; color:var(--sand); font-family:'Work Sans',sans-serif; font-size:12px; font-weight:600; outline:none; cursor:pointer; max-width:170px; text-overflow:ellipsis; }
  .tts-voice-select option{ background:var(--white); color:var(--ink); }

  /* Speaker buttons for passage and words */
  .para-tts-btn{
    display:inline-flex; align-items:center; justify-content:center;
    width:22px; height:22px; border-radius:50%; border:1px solid var(--line);
    background:var(--sand); color:var(--ocean-deep); cursor:pointer;
    margin-right:8px; vertical-align:middle; transition:all .15s ease;
    font-size:11px; line-height:1; flex:none; padding:0; user-select:none;
  }
  .para-tts-btn:hover{ background:var(--ocean-light); border-color:var(--ocean-mid); transform:scale(1.12); }
  .para-tts-btn.speaking{ background:var(--coral); color:var(--white); border-color:var(--coral); animation:pulse 1s infinite; }
  .para-tts-btn.paused{ background:var(--gold); color:var(--white); border-color:var(--gold); animation:none; }

  .word-tts-btn{
    display:inline-flex; align-items:center; justify-content:center;
    width:20px; height:20px; border-radius:50%; border:1px solid var(--line);
    background:var(--sand); color:var(--ocean-deep); cursor:pointer;
    margin-right:6px; vertical-align:middle; transition:all .15s ease;
    font-size:10.5px; line-height:1; flex:none; padding:0; user-select:none;
  }
  .word-tts-btn:hover{ background:var(--gold); color:var(--white); border-color:var(--gold); transform:scale(1.12); }
  .word-tts-btn.speaking{ background:var(--coral); color:var(--white); border-color:var(--coral); animation:pulse 1s infinite; }
  .word-tts-btn.paused{ background:var(--gold); color:var(--white); border-color:var(--gold); animation:none; }

  @keyframes pulse{ 0%,100%{ opacity:1; } 50%{ opacity:.55; } }

  body.edit-mode [contenteditable="true"]{ outline:1px dashed rgba(224,162,51,.55); outline-offset:2px; border-radius:4px; }
  body.edit-mode [contenteditable="true"]:focus{ outline:2px solid var(--gold); }
  .badge{ font-size:12px; font-weight:600; letter-spacing:.08em; text-transform:uppercase; padding:6px 12px; border-radius:999px; border:1px solid rgba(251,245,233,.35); color:var(--sand); background:rgba(251,245,233,.08); }
  h1.title{ font-size:clamp(26px,4vw,38px); font-weight:600; margin:0 0 12px; letter-spacing:-0.01em; }
  .objectives{ background:rgba(251,245,233,.08); border:1px solid rgba(251,245,233,.2); border-radius:10px; padding:12px 18px; }
  .objectives-label{ font-size:11px; font-weight:700; letter-spacing:.08em; text-transform:uppercase; color:var(--gold); margin-bottom:6px; }
  .objectives ul{ margin:0; padding-left:18px; font-size:13.5px; color:var(--sand); }
  .objectives li{ margin-bottom:2px; }
  .time-est{ font-size:12px; color:var(--ocean-light); margin-top:8px; opacity:.85; }

  .export-wrap{ position:relative; }
  .export-menu{ position:absolute; right:0; top:calc(100% + 6px); min-width:210px; background:var(--white); border:1px solid var(--line); border-radius:10px; box-shadow:0 8px 24px rgba(0,0,0,.12); padding:6px; z-index:50; display:none; }
  .export-menu.open{ display:block; }
  .export-item{ display:block; width:100%; text-align:left; border:none; background:none; padding:9px 12px; font-family:'Work Sans',sans-serif; font-size:12.5px; font-weight:600; color:var(--ink); border-radius:7px; cursor:pointer; }
  .export-item:hover{ background:var(--sand); }

  @media print{
    .hero-actions,.stage-nav,.submit-bar,.export-menu,.stripe,.modal-backdrop,.stage-footer-nav,.tip-btn,.activity-tabs,.subtabs,.light-tabs,.check-actions,.match-reset,.next-btn,.tts-voice-wrap,.para-tts-btn,.word-tts-btn{ display:none !important; }
    body{ background:#fff; }
    header.hero{ background:#0D5A62 !important; -webkit-print-color-adjust:exact; print-color-adjust:exact; }
    body.printing-current .stage-panel{ display:none !important; }
    body.printing-current .stage-panel.print-target{ display:block !important; }
    body.printing-all .stage-panel{ display:block !important; page-break-after:always; }
    body.printing-all .stage-panel:last-child{ page-break-after:auto; }
    .passage-pane,.activity-pane,.prompt-box,.exercise-box{ break-inside:avoid; }
  }

  .stage-nav{ position:sticky; top:0; z-index:30; background:var(--sand); border-bottom:1px solid var(--line); }
  .stage-nav-inner{ max-width:1180px; margin:0 auto; display:flex; gap:8px; padding:12px 24px; overflow-x:auto; }
  .stage-tab{ flex:none; display:flex; align-items:center; gap:8px; border:1.5px solid var(--line); background:var(--white); color:var(--ink-soft); padding:9px 16px; border-radius:999px; font-weight:600; font-size:13px; cursor:pointer; white-space:nowrap; transition:all .15s ease; }
  .stage-tab .dot{ width:6px; height:6px; border-radius:50%; background:var(--line); }
  .stage-tab.active{ background:var(--ocean-deep); border-color:var(--ocean-deep); color:var(--white); }
  .stage-tab.active .dot{ background:var(--gold); }
  .stage-tab:hover:not(.active){ border-color:var(--ocean-mid); }

  main{ max-width:1180px; margin:0 auto; padding:0 24px 100px; }
  .stage-panel{ display:none; }
  .stage-panel.active{ display:block; }
  #panel-while{ padding-top:24px; }

  section{ margin-top:40px; }
  section:first-child{ margin-top:28px; }
  .section-head{ display:flex; align-items:center; gap:10px; margin-bottom:14px; }
  .section-num{ font-family:'Fraunces',serif; font-size:14px; font-weight:600; color:var(--coral); border:1.5px solid var(--coral); border-radius:50%; width:28px; height:28px; display:flex; align-items:center; justify-content:center; flex:none; }
  h2.section-title{ font-family:'Fraunces',serif; font-size:21px; font-weight:600; margin:0; }
  .section-hint{ font-size:13px; color:var(--ink-soft); margin:-4px 0 16px 40px; }

  .tip-btn{ flex:none; width:24px; height:24px; border-radius:50%; border:1.5px solid var(--plum); background:var(--plum-light); color:var(--plum); font-size:12px; font-weight:700; cursor:pointer; display:inline-flex; align-items:center; justify-content:center; }
  .tip-btn:hover{ background:var(--plum); color:var(--white); }
  .modal-backdrop{ position:fixed; inset:0; background:rgba(20,25,26,.45); display:none; align-items:center; justify-content:center; z-index:200; padding:20px; }
  .modal-backdrop.show{ display:flex; }
  .modal-box{ background:var(--white); border-radius:14px; padding:20px 22px; max-width:420px; width:100%; position:relative; box-shadow:0 12px 40px rgba(0,0,0,.2); }
  .modal-box .modal-label{ font-size:11px; font-weight:700; letter-spacing:.06em; text-transform:uppercase; color:var(--plum); margin-bottom:8px; }
  .modal-box p{ margin:0; font-size:14px; color:var(--ink); line-height:1.6; }
  .modal-close{ position:absolute; top:10px; right:12px; border:none; background:none; font-size:18px; color:var(--ink-soft); cursor:pointer; line-height:1; }

  .prompt-box{ background:var(--white); border:1px solid var(--line); border-radius:var(--radius); padding:22px; }
  .prompt-box p.q{ margin:0 0 12px; font-size:15px; }
  .prompt-box textarea{ width:100%; min-height:64px; resize:vertical; border-radius:8px; border:1px solid var(--line); padding:10px 12px; font-family:'Work Sans',sans-serif; font-size:14px; outline:none; background:var(--sand); }
  .prompt-box textarea:focus{ border-color:var(--ocean-mid); }
  .subprompt-label{ font-size:11px; font-weight:700; letter-spacing:.05em; text-transform:uppercase; color:var(--ink-soft); margin:14px 0 8px; }

  .side-toggle{ display:flex; gap:10px; margin-bottom:14px; }
  .side-btn{ flex:1; border:1.5px solid var(--line); background:var(--white); padding:12px; border-radius:10px; font-weight:700; font-size:13.5px; cursor:pointer; color:var(--ink-soft); transition:all .15s ease; }
  .side-btn:hover{ border-color:var(--ocean-mid); }
  .side-btn.chosen{ background:var(--ocean-deep); border-color:var(--ocean-deep); color:var(--white); }

  .watch-row{ display:flex; flex-wrap:wrap; gap:8px; margin-bottom:18px; }
  .watch-chip{ background:var(--sand-deep); border:1px solid var(--line); color:var(--ink-soft); font-size:12.5px; font-weight:600; padding:6px 12px; border-radius:999px; }
  .flash-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:14px; }
  @media (max-width:720px){ .flash-grid{ grid-template-columns:1fr; } }
  .flash{ perspective:800px; height:110px; cursor:pointer; }
  .flash-inner{ position:relative; width:100%; height:100%; transition:transform .4s; transform-style:preserve-3d; }
  .flash.flipped .flash-inner{ transform:rotateY(180deg); }
  .flash-face{ position:absolute; inset:0; border-radius:10px; display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; padding:10px; backface-visibility:hidden; }
  .flash-front{ background:var(--ocean-deep); color:var(--white); }
  .flash-front .w{ font-family:'Fraunces',serif; font-size:18px; font-weight:600; }
  .flash-front .hint{ font-size:11px; opacity:.7; margin-top:6px; }
  .flash-back{ background:var(--gold-light); color:#6B4A0E; transform:rotateY(180deg); font-size:12px; line-height:1.4; }
  .flash-back .ex{ font-style:italic; margin-top:6px; opacity:.85; }

  .while-activity-tabs{ display:flex; gap:10px; flex-wrap:wrap; align-items:center; margin:0 0 24px; padding-bottom:16px; border-bottom:1px solid var(--line); }
  .activity-tab-group{ display:flex; gap:8px; flex-wrap:wrap; align-items:center; }
  .while-activity-tabs .subtabs{
    display:none; gap:6px; flex-wrap:wrap; align-items:center;
    margin:0 0 0 auto; padding:0; border:none;
  }
  .while-mode-details .while-activity-tabs .subtabs{ display:flex; }
  .while-split{ display:grid; grid-template-columns:1.6fr 1fr; gap:22px; align-items:start; }
  @media (max-width:900px){ .while-split{ grid-template-columns:1fr; } }
  .passage-column{ min-width:0; }
  .while-mode-details .passage-pane-full{ display:none; }
  .while-mode-gist .section-carousel{ display:none; }
  .passage-pane{ background:var(--white); border-radius:var(--radius); border:1px solid var(--line); padding:26px 28px; }
  .passage-pane p{ margin:0; font-size:15.5px; line-height:1.75; }
  .passage-para{ display:grid; grid-template-columns:28px 1fr; gap:10px; align-items:start; margin:0 0 18px; }
  .passage-para:last-child{ margin-bottom:0; }
  .passage-num{ font-family:'Fraunces',serif; font-size:18px; font-weight:600; color:var(--plum); line-height:1.75; text-align:right; user-select:none; }
  .passage-body{ min-width:0; border-radius:10px; transition:background .25s ease; }
  .passage-body.plogic-hl{ background:transparent; box-shadow:none; padding:0; margin:0; }
  .passage-para .para-tts-btn{ margin-left:6px; vertical-align:middle; position:relative; top:-1px; }

  /* Paragraph Logic — discourse markers & wavy steps in passage */
  .plogic-legend-bar{ display:flex; flex-wrap:wrap; gap:6px; align-items:center; margin:0 0 14px; padding:4px 0 12px; border-bottom:1px dashed var(--line); width:100%; }
  .plogic-legend-bar[hidden]{ display:none !important; }
  .plogic-legend-chip{ display:inline-flex; align-items:center; gap:6px; font-size:11px; font-weight:700; padding:4px 10px 4px 7px; border-radius:999px; border:1.5px solid var(--line); background:var(--white); color:var(--ink); cursor:pointer; font-family:'Work Sans',sans-serif; }
  .plogic-legend-chip .dot{ width:8px; height:8px; border-radius:50%; flex:none; }
  .plogic-legend-chip .zh{ font-weight:500; color:var(--ink-soft); }
  .plogic-legend-chip:hover{ border-color:var(--ink-soft); }
  .plogic-legend-chip.active{ border-color:var(--chip-deep); background:color-mix(in srgb, var(--chip-light) 45%, white); }
  .plogic-legend-reset{ font-size:11px; font-weight:700; padding:4px 10px; border-radius:999px; border:1.5px dashed var(--line); background:transparent; color:var(--ink-soft); cursor:pointer; font-family:'Work Sans',sans-serif; }
  .plogic-legend-reset:hover{ color:var(--ink); border-color:var(--ink-soft); }
  .plogic-legend-chip.marking{ box-shadow:0 0 0 2px var(--chip-deep); }
  .plogic-legend-hint{ width:100%; font-size:11px; color:var(--ink-soft); margin:2px 0 0; }
  .plogic-legend-add-btn{ font-size:14px; font-weight:800; width:28px; height:28px; padding:0; border-radius:999px; border:1.5px dashed var(--line); background:var(--white); color:var(--ink-soft); cursor:pointer; font-family:'Work Sans',sans-serif; line-height:1; flex:none; }
  .plogic-legend-add-btn:hover{ color:var(--ink); border-color:var(--ink-soft); background:var(--sand); }
  .plogic-legend-add-form{ display:flex; flex-wrap:wrap; gap:6px; align-items:center; width:100%; margin-top:4px; padding:8px 10px; border-radius:10px; border:1.5px solid var(--line); background:var(--sand); }
  .plogic-legend-add-form[hidden]{ display:none !important; }
  .plogic-legend-preset-colors{ display:flex; gap:4px; flex-wrap:wrap; }
  .plogic-legend-preset-swatch{ width:20px; height:20px; border-radius:50%; border:2px solid var(--white); box-shadow:0 0 0 1px var(--line); cursor:pointer; padding:0; flex:none; }
  .plogic-legend-preset-swatch:hover{ transform:scale(1.1); }
  .plogic-legend-add-form input[type="color"]{ width:32px; height:28px; padding:2px; border:1.5px solid var(--line); border-radius:6px; cursor:pointer; background:var(--white); flex:none; }
  .plogic-legend-add-form input[type="text"]{ flex:1; min-width:90px; font-size:11px; font-family:'Work Sans',sans-serif; padding:5px 8px; border:1.5px solid var(--line); border-radius:6px; background:var(--white); }
  .plogic-legend-add-confirm,.plogic-legend-add-cancel{ font-size:11px; font-weight:700; padding:5px 10px; border-radius:6px; border:1.5px solid var(--line); cursor:pointer; font-family:'Work Sans',sans-serif; }
  .plogic-legend-add-confirm{ background:var(--ocean-mid); border-color:var(--ocean-mid); color:var(--white); }
  .plogic-legend-add-confirm:hover{ filter:brightness(1.06); }
  .plogic-legend-add-cancel{ background:var(--white); color:var(--ink-soft); }
  .plogic-legend-add-cancel:hover{ color:var(--ink); }
  .sent-step.step-active{ text-decoration:underline wavy #C97A3D 2px; text-underline-offset:5px; }
  .dm{ border-radius:5px; transition:opacity .15s ease, filter .15s ease, background .15s ease, color .15s ease; }
  .passage-body.plogic-hl .dm[data-cat],
  .carousel-passage.plogic-hl .dm[data-cat]{ display:inline; padding:1px 5px; font-weight:700; }
  .passage-body.plogic-hl .dm[data-cat="cause"],
  .carousel-passage.plogic-hl .dm[data-cat="cause"]{ background:#F9CBA6; color:#C97A3D; }
  .passage-body.plogic-hl .dm[data-cat="contrast"],
  .carousel-passage.plogic-hl .dm[data-cat="contrast"]{ background:#F7C6D9; color:#C4577E; }
  .passage-body.plogic-hl .dm[data-cat="addition"],
  .carousel-passage.plogic-hl .dm[data-cat="addition"]{ background:#B7E4C7; color:#3F8259; }
  .passage-body.plogic-hl .dm[data-cat="sequence"],
  .carousel-passage.plogic-hl .dm[data-cat="sequence"]{ background:#DCF0EE; color:#0D5A62; }
  .passage-body.plogic-hl .dm[data-cat="hedge"],
  .carousel-passage.plogic-hl .dm[data-cat="hedge"]{ background:#CBC3E3; color:#6B5A9E; }
  .passage-body.plogic-filtering .dm[data-cat],
  .carousel-passage.plogic-filtering .dm[data-cat]{ opacity:.28; filter:grayscale(55%); }
  .passage-body.plogic-filtering .dm.filter-on,
  .carousel-passage.plogic-filtering .dm.filter-on{ opacity:1; filter:none; }
  .dm-float-btn{
    position:fixed; z-index:1200; width:30px; height:30px; border-radius:50%;
    border:2px solid #fff; color:#fff; font-size:18px; font-weight:800; line-height:1;
    display:none; align-items:center; justify-content:center; cursor:pointer;
    box-shadow:0 6px 18px rgba(26,32,38,.22); font-family:'Work Sans',sans-serif;
    padding:0; transform:translate(-50%, -120%);
  }
  .dm-float-btn.show{ display:flex; }
  .dm-float-btn:hover{ filter:brightness(1.06); transform:translate(-50%, -120%) scale(1.06); }
  .vocab{ background:var(--gold-light); color:#7A5610; padding:1px 5px; border-radius:5px; cursor:pointer; font-weight:600; border-bottom:2px solid var(--gold); transition:background .15s ease; }
  .vocab:hover{ background:var(--gold); color:var(--white); }
  .cue{ font-weight:700; color:var(--plum); border-bottom:1px dotted var(--plum); }
  .persist-hl{ background:var(--gold-light) !important; box-shadow:0 0 0 3px var(--gold); border-radius:6px; transition:background .3s ease, box-shadow .3s ease; }
  p.persist-hl{ padding:6px 8px; margin-left:-8px; margin-right:-8px; }
  .chip.persist-hl{ box-shadow:0 0 0 3px var(--gold); }

  .activity-pane{ min-width:0; }
  .activity-tab{ border:1.5px solid var(--line); background:var(--white); color:var(--ink-soft); padding:8px 14px; border-radius:999px; font-weight:700; font-size:13px; cursor:pointer; transition:all .15s ease; }
  .activity-tab.active{ background:var(--coral); border-color:var(--coral); color:var(--white); }
  .activity-tab:hover:not(.active){ border-color:var(--coral); }
  .activity-view{ display:none; } .activity-view.active{ display:block; }
  .activity-sub{ font-size:12.5px; color:var(--ink-soft); margin-bottom:14px; }

  .subtab{ border:1.5px solid var(--line); background:var(--white); color:var(--ink-soft); padding:6px 12px; border-radius:8px; font-weight:700; font-size:12px; cursor:pointer; }
  .subtab.active{ background:var(--ocean-mid); border-color:var(--ocean-mid); color:var(--white); }
  .subview{ display:none; } .subview.active{ display:block; }

  .light-tabs{
    display:flex; gap:16px; align-items:flex-end;
    min-height:calc(6px + 1.25em + 10px);
    margin:0 0 14px; padding:0;
    border-bottom:1px solid var(--line);
    box-sizing:content-box;
  }
  .light-tab{ border:none; background:none; padding:6px 2px 10px; font-family:'Work Sans',sans-serif; font-size:12.5px; font-weight:700; color:var(--ink-soft); cursor:pointer; border-bottom:2px solid transparent; margin-bottom:-1px; }
  .light-tab.active{ color:var(--coral); border-bottom-color:var(--coral); }
  .light-tab:hover:not(.active){ color:var(--ink); }
  .light-view{ display:none; } .light-view.active{ display:block; }
  .word-list{ display:flex; flex-direction:column; gap:2px; }

  .mcq-list{ display:flex; flex-direction:column; gap:8px; margin-bottom:16px; }
  .mcq-opt{ display:flex; gap:8px; align-items:flex-start; background:var(--white); border:1.5px solid var(--line); border-radius:10px; padding:10px 12px; cursor:pointer; font-size:13px; transition:all .15s ease; }
  .mcq-opt:hover{ border-color:var(--ocean-mid); }
  .mcq-opt .letter{ font-weight:700; color:var(--ocean-mid); flex:none; }
  .mcq-opt.correct{ border-color:#1F7A4C; background:#EAF6EF; }
  .mcq-opt.wrong{ border-color:var(--coral); background:var(--coral-light); }
  .mcq-feedback{ margin:-6px 0 16px; font-size:12.5px; color:var(--ink-soft); display:none; }
  .mcq-feedback.show{ display:block; }

  .match-wrap.compact{ background:var(--white); border:1px solid var(--line); border-radius:var(--radius); padding:18px; }
  .match-progress{ display:flex; align-items:center; gap:10px; margin-bottom:14px; }
  .match-progress .bar{ flex:1; height:5px; background:var(--sand-deep); border-radius:999px; overflow:hidden; }
  .match-progress .bar-fill{ height:100%; background:var(--coral); width:0%; transition:width .3s ease; }
  .match-progress .count{ font-size:12px; font-weight:600; color:var(--ink-soft); white-space:nowrap; }
  .match-reset{ border:none; background:none; color:var(--ocean-mid); font-size:12px; font-weight:600; cursor:pointer; text-decoration:underline; padding:0; }
  .match-columns{ display:grid; grid-template-columns:1fr 1fr; gap:14px; }
  .match-col-label{ font-size:11px; font-weight:700; letter-spacing:.05em; text-transform:uppercase; color:var(--ink-soft); margin-bottom:8px; }
  .chip{ display:block; width:100%; text-align:left; margin-bottom:7px; background:var(--sand); border:1.5px solid var(--line); border-radius:9px; padding:9px 11px; font-size:12.5px; cursor:pointer; font-family:'Work Sans',sans-serif; color:var(--ink); transition:all .12s ease; }
  .chip.word{ font-weight:700; }
  .chip:hover:not(.solved):not(.selected){ border-color:var(--ocean-mid); background:var(--ocean-light); }
  .chip.selected{ border-color:var(--coral); background:var(--coral-light); }
  .chip.solved{ border-color:#1F7A4C; background:#EAF6EF; color:#1F7A4C; cursor:default; }
  .chip.solved::after{ content:" ✓"; }
  .chip.shake{ animation:shake .35s ease; }
  @keyframes shake{ 0%,100%{ transform:translateX(0); } 25%{ transform:translateX(-5px); } 75%{ transform:translateX(5px); } }
  .done-banner{ display:none; margin-top:14px; padding:10px 14px; background:var(--gold-light); border:1px solid var(--gold); border-radius:10px; font-size:13px; color:#7A5610; text-align:center; }
  .done-banner.show{ display:block; }

  .fcard{ border-radius:12px; border:1px solid var(--line); overflow:hidden; margin-bottom:14px; background:var(--white); }
  .fcard-header{ display:flex; align-items:flex-start; justify-content:space-between; gap:10px; padding:12px 14px; cursor:pointer; }
  .fcard-header .htext .en{ font-family:'Fraunces',serif; font-weight:600; font-size:15px; }
  .fcard-header .htext .zh{ font-size:11.5px; color:var(--ink-soft); margin-top:1px; }
  .fcard-header .tag{ flex:none; font-size:10.5px; font-weight:700; color:var(--ink-soft); background:var(--sand); border-radius:999px; padding:3px 9px; margin-right:6px; }
  .fcard.structure .fcard-header{ background:var(--plum-light); }
  .fcard.twcard .fcard-header{ background:var(--ocean-light); cursor:default; }
  .fcard.twcard .fcard-header .htext .en{ color:var(--ocean-deep); text-decoration:none; }
  .fcard.twcard .fcard-header .tag{ background:var(--white); color:var(--ocean-deep); margin-right:0; }
  .tw-header-right{ display:flex; align-items:center; gap:6px; flex:none; }
  .plogic-btn,.zh-toggle-btn{ flex:none; width:26px; height:26px; border-radius:50%; border:1.5px solid rgba(13,90,98,.28); background:rgba(255,255,255,.75); color:var(--ocean-deep); cursor:pointer; display:inline-flex; align-items:center; justify-content:center; padding:0; line-height:1; transition:background .15s ease, border-color .15s ease, transform .15s ease; font-family:'Work Sans',sans-serif; font-size:12px; font-weight:800; }
  .plogic-btn svg{ width:14px; height:14px; display:block; }
  .plogic-btn:hover,.zh-toggle-btn:hover{ background:var(--white); border-color:var(--ocean-mid); }
  .plogic-btn.active{ background:var(--ocean-deep); border-color:var(--ocean-deep); color:var(--white); }
  .zh-toggle-btn.active{ background:var(--coral); border-color:var(--coral); color:var(--white); }
  /* Exploring Content — Chinese on fronts hidden until 中 is toggled */
  .content-zh{ display:none !important; }
  body.show-content-zh .content-zh{ display:block !important; }
  body.show-content-zh .plogic-flow-step .content-zh,
  body.show-content-zh .content-zh.inline{ display:inline !important; }
  .tw-qtext .content-zh{ margin-top:6px; font-family:'Work Sans',sans-serif; font-size:12.5px; font-style:normal; color:var(--ink-soft); line-height:1.4; }
  .front-q .content-zh{ margin-top:8px; font-style:normal; font-size:12.5px; color:var(--ink-soft); }
  .plogic-panel{ display:none; padding:10px 14px 14px; background:linear-gradient(180deg, #F7FBFA 0%, var(--white) 100%); border-bottom:1px dashed var(--line); }
  .plogic-panel.open{ display:block; }
  .plogic-flow-label{ font-size:10.5px; font-weight:800; letter-spacing:.06em; text-transform:uppercase; color:var(--ink-soft); margin:0 0 8px; }
  .plogic-flow-strip{ display:flex; align-items:center; flex-wrap:wrap; gap:5px; }
  .plogic-flow-step{ display:inline-flex; align-items:center; gap:6px; padding:6px 11px; border-radius:999px; border:1.5px solid var(--line); background:var(--white); cursor:pointer; font-size:11.5px; font-weight:700; color:var(--ink-soft); font-family:'Work Sans',sans-serif; transition:all .15s ease; }
  .plogic-flow-step .num{ width:16px; height:16px; border-radius:50%; background:var(--sand); color:var(--ink-soft); display:inline-flex; align-items:center; justify-content:center; font-size:10px; flex:none; }
  .plogic-flow-step .zh{ font-weight:500; opacity:.85; }
  .plogic-flow-step .content-zh{ font-weight:500; opacity:.85; margin-left:4px; }
  .plogic-flow-step:hover{ border-color:var(--coral); color:var(--ink); }
  .plogic-flow-step.active{ border-color:transparent; background:linear-gradient(135deg, #C97A3D, #C4577E); color:#fff; }
  .plogic-flow-step.active .num{ background:rgba(255,255,255,.28); color:#fff; }
  .plogic-flow-arrow{ color:var(--line); font-size:13px; flex:none; }
  .fcard.ddcard .fcard-header{ background:var(--plum-light); }
  .flip-icon{ flex:none; width:26px; height:26px; border-radius:50%; border:1.5px solid rgba(0,0,0,.15); background:rgba(255,255,255,.6); font-size:13px; cursor:pointer; display:flex; align-items:center; justify-content:center; }
  .flip-icon:hover{ background:var(--white); }
  .fcard-body{ padding:14px 16px; cursor:pointer; transition:transform .22s ease, opacity .22s ease; }
  .fcard-body.flipping{ transform:rotateY(90deg); opacity:0; }
  .fcard-face{ display:none; }
  .fcard-face.active{ display:block; }
  .front-q{ font-size:13.5px; color:var(--ink); font-style:italic; }
  .front-hint{ margin-top:10px; font-size:11px; color:var(--ink-soft); }
  .fcard-body ul{ margin:0 0 8px; padding-left:16px; font-size:12.5px; }
  .fcard-body li{ margin-bottom:4px; }
  .card-summary{ font-size:12px; color:var(--ink-soft); }
  .card-divider{ border-top:1px dashed var(--line); margin:10px 0; }
  .mindmap-wrap{ width:100%; }

  /* Text Walkthrough — typed question rows (card itself does not flip) */
  .tw-questions{ padding:0; }
  .tw-qitem{ border-top:1px dashed var(--line); }
  .tw-qitem:first-child{ border-top:none; }
  .tw-qface{ display:none; align-items:flex-start; gap:12px; padding:14px 16px; cursor:pointer; transition:transform .22s ease, opacity .22s ease; }
  .tw-qface.active{ display:flex; }
  .tw-qface.flipping{ transform:rotateY(90deg); opacity:0; }
  .tw-qtext{ flex:1; min-width:0; font-family:'Fraunces',serif; font-size:13.5px; font-style:italic; color:var(--ink); line-height:1.45; }
  .tw-qtext .qmark{ color:var(--coral); font-style:normal; font-weight:700; margin-right:4px; }
  .tw-answer{ flex:1; min-width:0; font-size:12.5px; color:var(--ink); line-height:1.55; }

  /* Section carousel — Details mode passage + Text Walkthrough */
  .section-carousel{ position:relative; }
  /* Match right-column .light-tabs block height so left card top aligns with TW card top */
  .carousel-dots{
    display:flex; justify-content:center; align-items:center; gap:8px;
    min-height:calc(6px + 1.25em + 10px);
    margin:0 0 14px; padding:0 0 10px;
    border-bottom:1px solid transparent;
    box-sizing:content-box;
  }
  .carousel-dot{ width:8px; height:8px; border-radius:50%; border:none; padding:0; background:var(--line); cursor:pointer; transition:transform .2s ease, background .2s ease; }
  .carousel-dot:hover{ background:var(--ink-soft); }
  .carousel-dot.active{ background:var(--coral); transform:scale(1.35); }
  .carousel-viewport{
    position:relative;
    overflow:hidden;
    /* inset card from clip edge so Signpost chips are never cut */
    padding:16px 0 14px;
  }
  .carousel-track-wrap{
    position:relative; flex:1; min-width:0;
    overflow:hidden;
    transition:height .35s ease;
    padding:0;
  }
  .carousel-track{ display:flex; align-items:flex-start; transition:transform .42s cubic-bezier(.4,.0,.2,1); }
  .carousel-slide{ flex:0 0 100%; min-width:0; padding:0 4px; box-sizing:border-box; }
  .carousel-slide-inner{
    background:var(--white);
    border:1px solid var(--line);
    border-radius:var(--radius);
    padding:28px 24px 20px;
    box-shadow:0 2px 12px rgba(26,32,38,.06);
    opacity:.72;
    transition:box-shadow .35s ease, opacity .35s ease, border-color .35s ease;
  }
  .carousel-slide.active .carousel-slide-inner{
    opacity:1;
    box-shadow:0 10px 28px rgba(26,32,38,.10), 0 2px 8px rgba(13,90,98,.06);
    border-color:color-mix(in srgb, var(--ocean-mid) 35%, var(--line));
  }
  .carousel-passage{ padding-top:0; }
  .carousel-passage .passage-para{ margin-bottom:14px; }
  .carousel-passage .passage-para:last-child{ margin-bottom:0; }
  .carousel-passage > .plogic-legend-bar{ width:100%; margin:0 0 14px; padding:0 0 12px; }
  .carousel-plogic-panel{ margin-top:16px; padding-top:14px; border-top:1px dashed var(--line); }
  .carousel-arrow{
    position:absolute; top:50%; transform:translateY(-50%);
    width:40px; height:40px;
    border:none; border-radius:50%;
    background:rgba(255,255,255,.72);
    color:var(--ink-soft);
    cursor:pointer;
    display:flex; align-items:center; justify-content:center;
    font-size:22px; line-height:1;
    backdrop-filter:blur(4px);
    box-shadow:0 2px 10px rgba(26,32,38,.08);
    transition:background .15s ease, color .15s ease, box-shadow .15s ease;
    z-index:3;
  }
  .carousel-arrow.prev{ left:10px; }
  .carousel-arrow.next{ right:10px; }
  .carousel-arrow:hover:not(:disabled){ background:rgba(255,255,255,.95); color:var(--ocean-deep); box-shadow:0 4px 14px rgba(26,32,38,.12); }
  .carousel-arrow:disabled{ opacity:.25; cursor:default; pointer-events:none; }
  @media (max-width:900px){
    .carousel-arrow{ width:34px; height:34px; font-size:18px; }
    .carousel-arrow.prev{ left:6px; }
    .carousel-arrow.next{ right:6px; }
    .carousel-slide-inner{ padding:22px 16px 18px; }
    .carousel-viewport{ padding:14px 0 12px; }
  }
  .tw-answer ul{ margin:0 0 6px; padding-left:16px; }
  .tw-answer li{ margin-bottom:3px; }
  .tw-answer .zh{ margin-top:8px; padding-top:8px; border-top:1px dashed var(--line); color:var(--ink-soft); font-size:12px; }
  .qtype-badge{ flex:none; display:inline-flex; align-items:center; gap:5px; font-size:11px; font-weight:700; border-radius:999px; padding:3px 9px 3px 3px; letter-spacing:.01em; line-height:1; white-space:nowrap; margin-top:1px; }
  .qtype-letter{ display:inline-flex; align-items:center; justify-content:center; width:18px; height:18px; border-radius:50%; font-size:10px; font-weight:800; color:#fff; }
  .qtype-badge.fact{ background:#D6EAF8; color:#1A6FA0; }
  .qtype-badge.fact .qtype-letter{ background:#1A6FA0; }
  .qtype-badge.infer{ background:var(--plum-light); color:#6B4E8E; }
  .qtype-badge.infer .qtype-letter{ background:#6B4E8E; }
  .qtype-badge.tone{ background:var(--gold-light); color:#7A5610; }
  .qtype-badge.tone .qtype-letter{ background:#C48A12; }
  .qtype-badge.vocabulary{ background:#E8EEF5; color:#3D5A80; }
  .qtype-badge.vocabulary .qtype-letter{ background:#3D5A80; }
  .qtype-badge.structure{ background:#D4EDDA; color:#1F7A4C; }
  .qtype-badge.structure .qtype-letter{ background:#1F7A4C; }
  .qtype-badge.reflect{ background:#FFE8D1; color:#C45C12; }
  .qtype-badge.reflect .qtype-letter{ background:#C45C12; }

  .lang-editor-bar{ display:flex; align-items:center; justify-content:flex-end; gap:8px; margin:0 0 10px; }
  .lang-add-btn,.lang-item-add{
    border:1.5px dashed var(--line); background:var(--white); color:var(--ocean-mid);
    font-size:12px; font-weight:700; padding:6px 12px; border-radius:8px; cursor:pointer;
    font-family:'Work Sans',sans-serif;
  }
  .lang-add-btn:hover,.lang-item-add:hover{ border-color:var(--ocean-mid); background:var(--ocean-light); }
  .vocab-flip{ position:relative; }
  .lang-card-del,.vocab-card-del,.lang-item-del{
    flex:none; width:22px; height:22px; border-radius:50%; border:1px solid var(--line);
    background:var(--white); color:var(--ink-soft); cursor:pointer; font-size:14px; line-height:1;
    display:inline-flex; align-items:center; justify-content:center; padding:0;
  }
  .lang-card-del:hover,.vocab-card-del:hover,.lang-item-del:hover{ color:var(--coral); border-color:var(--coral); background:var(--coral-light); }
  .vocab-flip-actions{ display:flex; align-items:center; gap:4px; }
  .lang-add-form{
    display:none; flex-direction:column; gap:8px; margin:0 0 12px; padding:12px;
    border:1px dashed var(--line); border-radius:10px; background:var(--sand);
  }
  .lang-add-form.open{ display:flex; }
  .lang-add-form label{ font-size:11px; font-weight:700; color:var(--ink-soft); }
  .lang-add-form input,.lang-add-form textarea{
    width:100%; box-sizing:border-box; border:1px solid var(--line); border-radius:8px;
    padding:7px 10px; font-size:12.5px; font-family:'Work Sans',sans-serif; background:var(--white); color:var(--ink);
  }
  .lang-add-form textarea{ min-height:56px; resize:vertical; }
  .lang-add-form .row{ display:flex; gap:8px; }
  .lang-add-form .row > *{ flex:1; }
  .lang-add-actions{ display:flex; gap:8px; justify-content:flex-end; }
  .lang-add-actions button{
    border:none; border-radius:8px; padding:6px 12px; font-size:12px; font-weight:700; cursor:pointer;
    font-family:'Work Sans',sans-serif;
  }
  .lang-add-save{ background:var(--ocean-mid); color:#fff; }
  .lang-add-cancel{ background:var(--white); border:1px solid var(--line) !important; color:var(--ink-soft); }
  .langcard .fcard-header{ background:var(--gold-light); }
  .lang-items{ padding:4px 14px 14px; }
  .lang-item{ display:flex; align-items:center; gap:8px; padding:8px 6px; border-radius:8px; font-size:12.5px; cursor:pointer; }
  .lang-item:hover{ background:var(--sand); }
  .lang-item .n{ font-weight:700; color:var(--gold); flex:none; }
  .lang-item-content{ flex:1; }

  /* Power Word / Phrase — individual flip cards */
  .vocab-flip-grid{ display:grid; grid-template-columns:1fr; gap:10px; }
  .vocab-flip{ border:1px solid var(--line); border-radius:12px; background:var(--white); overflow:hidden; }
  .vocab-flip-face{ display:none; align-items:flex-start; gap:10px; padding:12px 14px; cursor:pointer; transition:transform .22s ease, opacity .22s ease; min-height:64px; }
  .vocab-flip-face.active{ display:flex; }
  .vocab-flip-face.flipping{ transform:rotateY(90deg); opacity:0; }
  .vocab-flip-main{ flex:1; min-width:0; }
  .vocab-flip-top{ display:flex; align-items:center; gap:8px; flex-wrap:wrap; margin-bottom:4px; }
  .vocab-flip-word{ font-family:'Fraunces',serif; font-size:16px; font-weight:600; color:var(--ocean-deep); }
  .vocab-flip-pos{ font-size:11.5px; font-weight:600; color:var(--ink-soft); }
  .vocab-flip-en{ font-size:12.5px; color:var(--ink); line-height:1.45; }
  .vocab-flip-zh{ font-size:12.5px; color:var(--ink); line-height:1.5; margin-top:6px; }
  .vocab-trait{ display:inline-flex; align-items:center; font-size:10.5px; font-weight:700; letter-spacing:.02em; border-radius:999px; padding:3px 9px; background:var(--gold-light); color:#7A5610; }
  .vocab-flip.phrase .vocab-trait{ background:var(--ocean-light); color:var(--ocean-deep); }
  .vocab-flip-actions{ display:flex; flex-direction:column; gap:6px; flex:none; align-items:center; }

  .tf-list{ display:flex; flex-direction:column; gap:10px; }
  .tf-item{ background:var(--white); border:1px solid var(--line); border-radius:12px; padding:14px 16px; display:flex; align-items:center; gap:14px; flex-wrap:wrap; }
  .tf-text{ flex:1 1 220px; font-size:13.5px; display:flex; align-items:center; gap:8px; }
  .tf-num{ color:var(--coral); font-weight:700; font-family:'Fraunces',serif; }
  .tf-buttons{ display:flex; gap:6px; }
  .tf-btn{ border:1.5px solid var(--line); background:var(--white); color:var(--ink); padding:6px 14px; border-radius:8px; font-weight:600; font-size:12.5px; cursor:pointer; transition:all .15s ease; }
  .tf-btn:hover{ border-color:var(--ocean-mid); }
  .tf-btn.picked{ border-color:var(--ocean-mid); background:var(--ocean-light); }
  .tf-btn.chosen-correct{ background:#1F7A4C; border-color:#1F7A4C; color:var(--white); }
  .tf-btn.chosen-wrong{ background:var(--coral); border-color:var(--coral); color:var(--white); }
  .tf-btn.reveal-correct{ border-color:#1F7A4C; color:#1F7A4C; }
  .tf-feedback{ flex-basis:100%; font-size:12.5px; color:var(--ink-soft); padding-top:6px; border-top:1px dashed var(--line); margin-top:4px; display:none; }
  .tf-feedback.show{ display:block; }
  .check-actions{ display:flex; gap:10px; margin-top:16px; align-items:center; }
  .submit-btn{ background:var(--ocean-deep); color:var(--white); border:none; padding:10px 20px; border-radius:999px; font-weight:700; font-size:13px; cursor:pointer; }
  .submit-btn:hover{ background:#0A464C; }
  .check-score{ font-size:13px; font-weight:700; color:var(--ink-soft); display:none; }
  .check-score.show{ display:inline; }
  .retry-link{ border:none; background:none; color:var(--ocean-mid); font-size:12.5px; font-weight:600; cursor:pointer; text-decoration:underline; display:none; }
  .retry-link.show{ display:inline; }

  .speak-grid{ display:grid; grid-template-columns:1fr 1fr; gap:16px; }
  @media (max-width:720px){ .speak-grid{ grid-template-columns:1fr; } }
  .speak-card{ background:var(--ocean-deep); color:var(--sand); border-radius:var(--radius); padding:22px; }
  .speak-card .qnum{ font-family:'Fraunces',serif; font-size:32px; opacity:.35; line-height:1; }
  .speak-card p{ margin:8px 0 14px; font-size:16px; }
  .speak-card textarea{ width:100%; min-height:70px; resize:vertical; border-radius:8px; border:none; padding:10px 12px; font-family:'Work Sans',sans-serif; font-size:13px; background:rgba(251,245,233,.12); color:var(--sand); outline:none; }
  .speak-card textarea::placeholder{ color:rgba(251,245,233,.55); }
  .speak-card textarea:focus{ background:rgba(251,245,233,.2); }

  .match-wrap{ background:var(--white); border:1px solid var(--line); border-radius:var(--radius); padding:28px; }
  .match-wrap .match-columns{ grid-template-columns:1fr 1fr; gap:28px; }
  .match-wrap .chip{ font-size:14px; padding:11px 14px; }

  .strategy-tag{ display:inline-block; font-size:11px; font-weight:700; letter-spacing:.05em; text-transform:uppercase; padding:4px 10px; border-radius:999px; margin-bottom:10px; }
  .strategy-tag.self{ background:var(--gold-light); color:#7A5610; }
  .strategy-tag.world{ background:var(--coral-light); color:#9A3F1B; }

  .stage-footer-nav{ display:flex; justify-content:flex-end; margin-top:44px; }
  .next-btn{ background:var(--coral); color:var(--white); border:none; padding:12px 22px; border-radius:999px; font-weight:700; font-size:14px; cursor:pointer; }
  .next-btn:hover{ background:#CC5F30; }

  footer{ text-align:center; font-size:12px; color:var(--ink-soft); padding:30px 24px 50px; }
</style>
</head>
<body>

<header class="hero">
  <div class="hero-inner" id="heroInner"></div>
</header>

<div class="stripe"></div>

<nav class="stage-nav">
