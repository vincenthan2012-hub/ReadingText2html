function collectTextWalkthrough() {
  return (whileR.textWalkthrough || []).map((c, i) => {
    const card = twCardEls[i];
    if (!card) return JSON.parse(JSON.stringify(c));
    const updated = JSON.parse(JSON.stringify(c));
    updated.title = card.querySelector('.fcard-header .en')?.textContent.trim() || updated.title;
    updated.subtitle = card.querySelector('.fcard-header .zh')?.textContent.trim() || updated.subtitle;
    card.querySelectorAll('.tw-qitem').forEach((item, qi) => {
      if (!updated.questions || !updated.questions[qi]) return;
      const qtext = item.querySelector('.tw-qface.front .tw-qtext');
      if (qtext) {
        const clone = qtext.cloneNode(true);
        clone.querySelector('.qmark')?.remove();
        clone.querySelectorAll('.content-zh').forEach(el => el.remove());
        updated.questions[qi].question = clone.textContent.replace(/\s+/g, ' ').trim();
        const qZh = qtext.querySelector('.content-zh');
        if (qZh) updated.questions[qi].questionZh = qZh.textContent.trim();
      }
    });
    return updated;
  });
}

function collectEditableFields(data) {
  const t = (sel) => document.querySelector(sel)?.textContent.trim();
  if (data.meta) {
    data.meta.titleEn = t('h1.title') || data.meta.titleEn;
    data.meta.timeEstimate = t('.time-est') || data.meta.timeEstimate;
    data.meta.footer = document.getElementById('pageFooter')?.textContent.trim() || data.meta.footer;
    const objs = [...document.querySelectorAll('.objectives li')].map(li => li.textContent.trim()).filter(Boolean);
    if (objs.length) data.meta.objectives = objs;
  }
  if (data.preReading?.leadIn) {
    data.preReading.leadIn.prompt = t('#preLeadIn .prompt-box .q') || data.preReading.leadIn.prompt;
  }
  if (data.preReading?.prediction) {
    data.preReading.prediction.hint = t('#prePrediction .section-hint') || data.preReading.prediction.hint;
    data.preReading.prediction.prompt = t('#prePrediction .prompt-box .q') || data.preReading.prediction.prompt;
  }
  if (data.postReading?.predictionCheck) {
    data.postReading.predictionCheck.prompt = t('#panel-post section:nth-child(1) .prompt-box .q') || data.postReading.predictionCheck.prompt;
  }
  if (data.postReading?.textToSelf) {
    data.postReading.textToSelf.prompt = t('#panel-post section:nth-child(3) .prompt-box .q') || data.postReading.textToSelf.prompt;
  }
  if (data.postReading?.textToWorld) {
